{
  "name": "cube27-talent",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-07-15",
  "compatibility_flags": ["nodejs_compat"],

  // Because this file exists, Cloudflare manages plain variables from here and
  // the Pages dashboard accepts secrets only. Everything below is non-secret
  // and safe to commit: hostnames and the published recipient addresses.
  //
  // The two real secrets, RESEND_API_KEY and TURNSTILE_SECRET_KEY, must NEVER
  // appear here. Set them per environment in the dashboard under
  // Settings -> Variables and secrets, as encrypted secrets.
  //
  // Changing a value here requires a deployment — unlike dashboard variables,
  // which took effect on the next request.

  // Production. Top-level `vars` is the production environment for Pages.
  "vars": {
    "ENVIRONMENT": "production",
    "SITE_URL": "https://talent.cube27.com",
    "ALLOWED_HOSTS": "talent.cube27.com",
    "RESEND_FROM": "Cube27 Talent <talent@mail.cube27.com>",
    "RESEND_REPLY_TO": "talent@cube27.com",
    "EMPLOYER_LEADS_TO": "talent@cube27.com",
    "CANDIDATE_APPLICATIONS_TO": "talent-apply@cube27.com",
  },

  // Preview. `vars` is a non-inheritable key: an environment that defines it
  // replaces the production block outright rather than merging, so every
  // variable is repeated here. Omitting one leaves it undefined in preview,
  // and both endpoints fail closed on a missing value.
  "env": {
    "preview": {
      "vars": {
        "ENVIRONMENT": "preview",
        "SITE_URL": "https://talent-preview.cube27.com",
        "ALLOWED_HOSTS": "talent-preview.cube27.com",
        // Visibly non-production sender. Resend verifies the domain, not the
        // local part, so this needs no extra setup.
        "RESEND_FROM": "Cube27 Talent (preview) <talent-preview@mail.cube27.com>",
        "RESEND_REPLY_TO": "talent@cube27.com",
        // Dedicated preview inboxes keep test leads and resumes isolated from
        // both live recruitment queues without relying on plus-addressing.
        "EMPLOYER_LEADS_TO": "talent-leads-preview@cube27.com",
        "CANDIDATE_APPLICATIONS_TO": "talent-apply-preview@cube27.com",
      },
    },
  },
}
