---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import Hero from "@/components/sections/Hero.astro";
import ProcessRail from "@/components/sections/ProcessRail.astro";
import Lifecycle from "@/components/sections/Lifecycle.astro";
import ExpertiseSelector from "@/components/sections/ExpertiseSelector.astro";
import Compliance from "@/components/sections/Compliance.astro";
import LeadershipHiring from "@/components/sections/LeadershipHiring.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import Faq from "@/components/ui/Faq.astro";
import { EMPLOYER_FAQS } from "@/data/faqs";
import { PROCESS_HEADING, PROCESS_LEDE } from "@/data/process";
import {
  faqSchema,
  organizationSchema,
  serviceSchema,
  websiteSchema,
} from "@/lib/schema";

const jsonLd = [
  organizationSchema(),
  websiteSchema(),
  serviceSchema(),
  faqSchema(EMPLOYER_FAQS),
];
---

<Layout jsonLd={jsonLd}>
  <div class="landing-scale">
    <Hero />

    <Section id="process" tone="deep">
      <SectionHead
        heading={PROCESS_HEADING}
        lede={PROCESS_LEDE}
        invert
        centered
      />
      <ProcessRail />
    </Section>

    <Section id="lifecycle" tone="surface" bordered>
      <SectionHead
        heading="Support that continues after the hire"
        lede="Onboarding and ongoing employee support stay covered."
        centered
      />
      <Lifecycle />
    </Section>

    <Section id="expertise">
      <SectionHead
        heading="Hire across every critical function"
        lede="Specialists, operators, and executives across critical functions."
        centered
      />
      <ExpertiseSelector />
    </Section>

    <Section id="compliance" tone="surface" bordered>
      <Compliance />
    </Section>

    <Section id="leadership">
      <LeadershipHiring />
    </Section>

    <Section id="faq" tone="surface" bordered narrow>
      <SectionHead heading="FAQs" centered />
      <Faq items={EMPLOYER_FAQS} />
    </Section>

    <FinalCta />
  </div>
</Layout>

<style>
  .landing-scale {
    --c27-container: 86rem;
  }
</style>
