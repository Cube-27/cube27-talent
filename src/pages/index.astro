---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import Hero from "@/components/sections/Hero.astro";
import ProcessRail from "@/components/sections/ProcessRail.astro";
import Lifecycle from "@/components/sections/Lifecycle.astro";
import ExpertiseSelector from "@/components/sections/ExpertiseSelector.astro";
import Compliance from "@/components/sections/Compliance.astro";
import LeadershipHiring from "@/components/sections/LeadershipHiring.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import Faq from "@/components/ui/Faq.astro";
import { EMPLOYER_FAQS } from "@/data/faqs";
import { PROCESS_HEADING, PROCESS_LEDE } from "@/data/process";
import {
  faqSchema,
  organizationSchema,
  serviceSchema,
  websiteSchema,
} from "@/lib/schema";

const jsonLd = [
  organizationSchema(),
  websiteSchema(),
  serviceSchema(),
  faqSchema(EMPLOYER_FAQS),
];
---

<Layout jsonLd={jsonLd}>
  <Hero />

  <Section id="process" tone="surface">
    <SectionHead
      index="01"
      label="How we hire"
      heading={PROCESS_HEADING}
      lede={PROCESS_LEDE}
    />
    <ProcessRail />
  </Section>

  <Section id="lifecycle">
    <SectionHead
      index="02"
      label="After the hire"
      heading="Support that continues after the hire"
      lede="Onboarding and ongoing employee support stay covered."
    />
    <Lifecycle />
  </Section>

  <Section id="expertise">
    <ExpertiseSelector
      index="03"
      heading="Hire across every critical function"
      lede="Specialists, operators, and executives across critical functions."
    />
  </Section>

  <Section id="compliance" tone="surface">
    <Compliance index="04" />
  </Section>

  {
    /* Shares the tone of the compliance band above it and carries no top
      padding, so the portrait runs flush into that band as one continuous
      field. A tone change here would cut across the top of the image. */
  }
  <Section id="leadership" tone="surface" class="!pt-0">
    <LeadershipHiring index="05" />
  </Section>

  <Section id="faq">
    <div class="c27-faq-split">
      <SectionHead
        index="06"
        label="Common ground"
        heading="FAQs"
        align="stack"
      />
      <Faq items={EMPLOYER_FAQS} />
    </div>
  </Section>

  <FinalCta />
</Layout>
