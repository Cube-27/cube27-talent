---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import { ROUTES, SITE_CONFIG } from "@/site-config";

const title = `Application received | ${SITE_CONFIG.brand}`;
---

<Layout
  title={title}
  description="Your application has been received."
  noindex
  bare
>
  <Section
    narrow
    class="c27-blueprint -mt-[4.5rem] pt-[calc(var(--c27-pad-section)+4.5rem)]"
  >
    <div class="max-w-[50rem] border-t border-c27-line pt-8">
      <h1 class="c27-h1">Your profile is with our team.</h1>
      <p class="c27-lede mt-5">
        Check your email for confirmation. We’ll contact you when your profile
        matches a relevant role.
      </p>
      <p class="mt-4 text-body-sm leading-relaxed text-c27-ink-2">
        Submitting a profile does not assure screening, an interview,
        employment, or an assignment. For a correction or deletion request,
        write to {SITE_CONFIG.organization.privacyEmail}.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={ROUTES.join} variant="primary">For talent</Button>
        <Button href={ROUTES.home} variant="line">Back to home</Button>
      </div>
    </div>
  </Section>
</Layout>
