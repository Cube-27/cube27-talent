---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import CheckMark from "@/components/ui/CheckMark.astro";
import { ROUTES, SITE_CONFIG } from "@/site-config";

const title = `Application received | ${SITE_CONFIG.brand}`;
---

<Layout
  title={title}
  description="Your application has been received."
  noindex
  bare
>
  <Section narrow>
    <div class="max-w-[46rem]">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-c27-line bg-c27-surface px-3.5 py-1.5 text-caption font-semibold text-c27-blue-d"
      >
        <CheckMark size={15} tone="blue" />
        Application received
      </span>
      <h1 class="c27-h2 mt-5">Thank you — the profile is with Cube27</h1>
      <p class="c27-lede mt-4">
        A confirmation has been sent to the email address supplied, with a
        reference number. Cube27 will consider the profile against suitable
        client requirements and make contact if there is a relevant next step.
      </p>
      <p class="mt-4 text-body-sm text-c27-ink-2">
        Submitting a profile does not guarantee screening, an interview,
        employment or an assignment. To correct or delete a profile, reply to
        the confirmation email or write to {
          SITE_CONFIG.organization.privacyEmail
        }.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={ROUTES.how} variant="line">The screening process</Button>
        <Button href={ROUTES.home} variant="line">Back to home</Button>
      </div>
    </div>
  </Section>
</Layout>
