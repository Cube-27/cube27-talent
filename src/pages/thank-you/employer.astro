---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import { ROUTES, SITE_CONFIG } from "@/site-config";

const title = `Thank you | ${SITE_CONFIG.brand}`;
---

<Layout
  title={title}
  description="Thank you for your interest. Your hiring enquiry has been received."
  noindex
  bare
>
  <Section
    narrow
    class="c27-blueprint -mt-[4.5rem] pt-[calc(var(--c27-pad-section)+4.5rem)]"
  >
    <div class="max-w-[50rem] border-t border-c27-line pt-8">
      <h1 class="c27-h1">Thank you for your interest.</h1>
      <p class="c27-lede mt-5">
        We have received your enquiry. Check your email for confirmation. We’ll
        review the details and contact you directly.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={ROUTES.how} variant="primary">See how we hire</Button>
        <Button href={ROUTES.home} variant="line">Back to home</Button>
      </div>
    </div>
  </Section>
</Layout>
