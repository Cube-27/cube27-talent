---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import CheckMark from "@/components/ui/CheckMark.astro";
import { ROUTES, SITE_CONFIG } from "@/site-config";

/**
 * Conversion destination for the employer funnel. Plan §11.3.
 * noindex, and it renders no submitted data — a direct visit sees the same
 * generic confirmation, so nothing leaks through URL, markup or history.
 */
const title = `Requirement received | ${SITE_CONFIG.brand}`;
---

<Layout
  title={title}
  description="Your hiring requirement has been received."
  noindex
  bare
>
  <Section narrow>
    <div class="max-w-[46rem]">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-c27-line bg-c27-surface px-3.5 py-1.5 text-caption font-semibold text-c27-green-d"
      >
        <CheckMark size={15} />
        Requirement received
      </span>
      <h1 class="c27-h2 mt-5">Thank you — the requirement is with Cube27</h1>
      <p class="c27-lede mt-4">
        A confirmation has been sent to the email address supplied, with a
        reference number. Cube27 will review whether the requirement fits its
        technical screening scope and current capacity, then make contact.
      </p>
      <p class="mt-4 text-body-sm text-c27-ink-2">
        Submitting a requirement does not by itself create a commercial
        engagement. Commercial terms are agreed in writing before candidates are
        presented.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <Button href={ROUTES.how} variant="line">How it works</Button>
        <Button href={ROUTES.home} variant="line">Back to home</Button>
      </div>
    </div>
  </Section>
</Layout>
