---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Compliance from "@/components/sections/Compliance.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import { VERIFIED_PROOF } from "@/data/proof";
import { ROUTES, SITE_CONFIG } from "@/site-config";
import { serviceSchema } from "@/lib/schema";

const title = `Why us — Enterprise hiring and workforce compliance | ${SITE_CONFIG.brand}`;
const description =
  "Operator-led hiring shaped by Fortune 500 experience, C-suite leadership, evidence-led assessment, and ongoing workforce compliance.";

const jsonLd = [serviceSchema()];

const OPERATOR_PROOF = [
  {
    title: "Fortune 500 experience",
    body: "Our core team has led and built teams serving Fortune 500 companies.",
    icon: "users" as const,
    surfaceClass: "bg-c27-tint-violet",
    iconClass: "text-c27-icon-violet c27-tile-violet",
  },
  {
    title: "C-suite perspective",
    body: "Core team members have held CTO and other C-suite roles, with direct accountability for people and outcomes.",
    icon: "compass" as const,
    surfaceClass: "bg-c27-surface",
    iconClass: "text-c27-icon-blue c27-tile-sky",
  },
  {
    title: "Functions built from the ground up",
    body: "We know how to define a function, hire its early team, and establish the standards that help it perform.",
    icon: "chart" as const,
    surfaceClass: "bg-c27-tint-mint",
    iconClass: "text-c27-icon-green c27-tile-mint",
  },
];

const HIRING_STANDARDS = [
  {
    title: "Real work first",
    body: "Candidates complete work relevant to the role before meeting your team.",
    icon: "board" as const,
  },
  {
    title: "Practitioner review",
    body: "People who know the discipline review the evidence and interview candidates.",
    icon: "person" as const,
  },
  {
    title: "Decision context",
    body: "Shortlists show strengths and gaps so your team can compare candidates clearly.",
    icon: "check" as const,
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Section class="c27-sky-field" bordered>
    <div
      class="grid gap-[clamp(2.25rem,7vw,6rem)] lg:grid-cols-[minmax(0,1.05fr)_minmax(24rem,0.95fr)] lg:items-center"
    >
      <div class="c27-rise">
        <h1 class="c27-display max-w-[15ch]">
          Built for teams where every hire matters
        </h1>
        <p
          class="c27-lede mt-7 max-w-[60ch] text-[clamp(1.05rem,1.7vw,1.3rem)] leading-relaxed"
        >
          Enterprise leadership experience and evidence-led hiring discipline
          shape every team we build.
        </p>
        <div class="mt-8">
          <Button href={ROUTES.hire} variant="primary" arrow
            >Build your team</Button
          >
        </div>
      </div>

      <aside
        class="c27-card-shadow c27-card-pad c27-rise border border-c27-line bg-c27-surface"
        style="--c27-d:80ms"
      >
        <h2 class="c27-h3-lg font-semibold">Experience behind the work</h2>
        <ul class="mt-6 border-t border-c27-line sm:mt-7">
          {
            OPERATOR_PROOF.map((item) => (
              <li class="grid grid-cols-[2.75rem_minmax(0,1fr)] items-center gap-4 border-b border-c27-line py-4 sm:py-5">
                <span
                  class:list={[
                    "grid size-11 place-items-center",
                    item.iconClass,
                  ]}
                  aria-hidden="true"
                >
                  <Icon name={item.icon} size={20} />
                </span>
                <p class="font-display text-body font-semibold leading-snug text-c27-ink">
                  {item.title}
                </p>
              </li>
            ))
          }
        </ul>
        <p class="mt-6 text-body-sm leading-relaxed text-c27-ink-2">
          That operator perspective informs how roles are defined, candidates
          are assessed, and teams are supported after selection.
        </p>
      </aside>
    </div>
  </Section>

  <Section id="operator-proof">
    <div class="c27-rise">
      <div
        class="grid gap-7 border-b border-c27-line pb-[clamp(2.5rem,5vw,4rem)] lg:grid-cols-[minmax(0,0.8fr)_minmax(28rem,1.2fr)] lg:items-end"
      >
        <h2 class="c27-h2">Leadership experience behind every search</h2>
        <p class="c27-lede leading-relaxed">
          We approach hiring as operators who have been accountable for the
          teams and functions being built.
        </p>
      </div>

      <div class="grid border-x border-b border-c27-line md:grid-cols-3">
        {
          OPERATOR_PROOF.map((item, index) => (
            <article
              class:list={[
                "c27-card-shadow c27-card-pad grid content-between gap-6 border-b border-c27-line last:border-b-0 md:min-h-64 md:gap-10 md:border-b-0",
                index > 0 && "md:border-l",
                item.surfaceClass,
              ]}
            >
              <span
                class:list={["grid size-14 place-items-center", item.iconClass]}
                aria-hidden="true"
              >
                <Icon name={item.icon} size={26} />
              </span>
              <div>
                <h3 class="c27-h3-lg font-semibold text-c27-ink">
                  {item.title}
                </h3>
                <p class="mt-3 max-w-[48ch] text-body-sm leading-relaxed text-c27-ink-2">
                  {item.body}
                </p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </Section>

  <Section id="hiring-standards" tone="deep" bordered>
    <div class="c27-rise">
      <div
        class="grid gap-7 border-b border-c27-line-deep pb-[clamp(2.5rem,5vw,4rem)] lg:grid-cols-[minmax(0,0.85fr)_minmax(28rem,1.15fr)] lg:items-end"
      >
        <h2 class="c27-h2 text-c27-on-deep">Evidence-led hiring, end to end</h2>
        <p class="max-w-[62ch] leading-relaxed text-c27-on-deep-2">
          AI can assist sourcing and screening. People review the evidence and
          make every assessment and hiring decision.
        </p>
      </div>

      <div class="relative mt-[clamp(2.5rem,5vw,4rem)]">
        <div
          class="absolute left-6 right-6 top-6 hidden h-px bg-c27-line-deep lg:block"
          aria-hidden="true"
        >
        </div>
        <ol class="grid gap-8 lg:grid-cols-3 lg:gap-12">
          {
            HIRING_STANDARDS.map((item) => (
              <li class="relative">
                <span
                  class="relative z-10 grid size-12 place-items-center border border-c27-line-deep bg-c27-deep text-c27-on-deep-accent"
                  aria-hidden="true"
                >
                  <Icon name={item.icon} size={24} />
                </span>
                <h3 class="c27-h3-lg mt-6 font-semibold text-c27-on-deep">
                  {item.title}
                </h3>
                <p class="mt-3 max-w-[36ch] text-body-sm leading-relaxed text-c27-on-deep-2">
                  {item.body}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </Section>

  <Section id="compliance" tone="sky" bordered>
    <Compliance />
  </Section>

  <Section tone="surface" bordered>
    <div
      class="c27-rise grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(30rem,1.2fr)] lg:items-end"
    >
      <div>
        <h2 class="c27-h2">A track record built over time</h2>
        <p class="c27-lede mt-5 leading-relaxed">
          Approved scale metrics from the work behind our hiring practice.
        </p>
      </div>
      <dl class="grid border-x border-t border-c27-line sm:grid-cols-3">
        {
          VERIFIED_PROOF.map((point, index) => (
            <div
              class:list={[
                "c27-card-shadow c27-card-pad-sm grid grid-cols-[minmax(0,1fr)_auto] items-center gap-4 border-b border-c27-line bg-c27-surface sm:block",
                index > 0 && "sm:border-l",
              ]}
            >
              <dt class="text-body-sm leading-relaxed text-c27-ink-2">
                {point.label}
              </dt>
              <dd class="font-display text-[clamp(1.75rem,3vw,2.5rem)] font-semibold tracking-[-0.035em] text-c27-ink sm:mt-3">
                {point.value}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>
  </Section>

  <FinalCta
    heading="Build the team your business needs"
    body="Tell us the roles, standards, and outcomes that matter."
  />
</Layout>
