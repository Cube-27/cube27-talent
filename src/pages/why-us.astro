---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import Icon from "@/components/ui/Icon.astro";
import Compliance from "@/components/sections/Compliance.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import { VERIFIED_PROOF } from "@/data/proof";
import { ROUTES, SITE_CONFIG } from "@/site-config";
import { serviceSchema } from "@/lib/schema";

const title = `Why us — Enterprise hiring and workforce compliance | ${SITE_CONFIG.brand}`;
const description =
  "Operator-led hiring shaped by Fortune 500 experience, C-suite leadership, evidence-led assessment, and ongoing workforce compliance.";

const jsonLd = [serviceSchema()];

const OPERATOR_PROOF = [
  {
    title: "Fortune 500 experience",
    body: "Our core team has led and built teams serving Fortune 500 companies.",
    icon: "users" as const,
  },
  {
    title: "C-suite perspective",
    body: "Core team members have held CTO and other C-suite roles, with direct accountability for people and outcomes.",
    icon: "compass" as const,
  },
  {
    title: "Functions built from the ground up",
    body: "We know how to define a function, hire its early team, and establish the standards that help it perform.",
    icon: "chart" as const,
  },
];

const HIRING_STANDARDS = [
  {
    title: "Real work first",
    body: "Candidates complete work relevant to the role before meeting your team.",
    icon: "board" as const,
  },
  {
    title: "Practitioner review",
    body: "People who know the discipline review the evidence and interview candidates.",
    icon: "person" as const,
  },
  {
    title: "Decision context",
    body: "Shortlists show strengths and gaps so your team can compare candidates clearly.",
    icon: "check" as const,
  },
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Section
    class="c27-blueprint -mt-[4.5rem] pt-[calc(var(--c27-pad-section)+4.5rem)]"
  >
    <div class="why-hero">
      <div class="c27-rise">
        <Eyebrow>Operator-led hiring</Eyebrow>
        <h1 class="c27-display mt-6 max-w-[15ch]">
          Built for teams where every hire matters
        </h1>
      </div>
      <div class="c27-rise why-hero-aside" style="--c27-d:80ms">
        <p class="c27-lede">
          Enterprise leadership experience and evidence-led hiring discipline
          shape every team we build.
        </p>
        <Button href={ROUTES.hire} variant="primary" arrow class="mt-8">
          Build your team
        </Button>
      </div>
    </div>
  </Section>

  <Section id="operator-proof" tone="surface">
    <SectionHead
      heading="Leadership experience behind every search"
      lede="We approach hiring as operators who have been accountable for the teams and functions being built."
    />

    <div class="c27-rule-grid" style="--c27-cols:3">
      {
        OPERATOR_PROOF.map((item, index) => (
          <article class="c27-rise" style={`--c27-d:${index * 60}ms`}>
            <Icon name={item.icon} size={24} class="text-c27-accent" />
            <h3 class="c27-card-title mt-4 font-semibold text-c27-ink">
              {item.title}
            </h3>
            <p class="mt-2 max-w-[34ch] text-body-sm leading-relaxed text-c27-ink-2">
              {item.body}
            </p>
          </article>
        ))
      }
    </div>

    <p
      class="c27-rise mt-[clamp(2rem,4vw,3rem)] max-w-[58ch] text-body-sm leading-relaxed text-c27-ink-2"
    >
      That operator perspective informs how roles are defined, candidates are
      assessed, and teams are supported after selection.
    </p>
  </Section>

  <Section id="hiring-standards">
    <SectionHead
      heading="Evidence-led hiring, end to end"
      lede="AI can assist sourcing and screening. People review the evidence and make every assessment and hiring decision."
    />

    <ul class="c27-rule-grid" style="--c27-cols:3">
      {
        HIRING_STANDARDS.map((item, index) => (
          <li class="c27-rise" style={`--c27-d:${index * 60}ms`}>
            <Icon name={item.icon} size={24} class="text-c27-accent" />
            <h3 class="c27-card-title mt-4 font-semibold text-c27-ink">
              {item.title}
            </h3>
            <p class="mt-2 max-w-[34ch] text-body-sm leading-relaxed text-c27-ink-2">
              {item.body}
            </p>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section id="compliance" tone="surface">
    <Compliance />
  </Section>

  <Section>
    <SectionHead
      heading="A track record built over time"
      lede="Approved scale metrics from the work behind our hiring practice."
    />
    <dl class="c27-rule-grid" style="--c27-cols:3">
      {
        VERIFIED_PROOF.map((point, index) => (
          <div class="c27-rise" style={`--c27-d:${index * 60}ms`}>
            <dt class="c27-side-label">{point.label}</dt>
            <dd class="c27-metric mt-3">{point.value}</dd>
          </div>
        ))
      }
    </dl>
  </Section>

  <FinalCta />
</Layout>

<style>
  .why-hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2.25rem, 6vw, 5rem);
    align-items: end;
  }

  .why-hero-aside {
    max-width: 34rem;
  }

  @media (max-width: 56.25rem) {
    .why-hero {
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
