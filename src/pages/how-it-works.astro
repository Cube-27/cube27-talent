---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import HowItWorksHero from "@/components/sections/HowItWorksHero.astro";
import ProcessRail from "@/components/sections/ProcessRail.astro";
import Lifecycle from "@/components/sections/Lifecycle.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import { ROUTES, SITE_CONFIG } from "@/site-config";
import { breadcrumbSchema, howToHiringProcessSchema } from "@/lib/schema";

const title = `How we hire — Evidence-based talent assessment | ${SITE_CONFIG.brand}`;
const description =
  "Role-specific assessments, practitioner interviews, and focused shortlists for confident hiring decisions.";

const jsonLd = [
  breadcrumbSchema([{ name: "How we hire", path: ROUTES.how }]),
  howToHiringProcessSchema(),
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <HowItWorksHero />

  <Section tone="deep">
    <SectionHead
      heading="See how the shortlist takes shape"
      lede="Each phase adds context while keeping judgment in human hands."
      invert
      centered
    />
    <ProcessRail />
  </Section>

  <Section tone="surface" bordered>
    <SectionHead
      heading="Support after selection"
      lede="Onboarding and ongoing employee support stay covered."
      centered
    />
    <Lifecycle />
  </Section>

  <FinalCta heading="Build the team you need" body="Tell us who you need." />
</Layout>
