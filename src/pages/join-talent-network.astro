---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import CandidateForm from "@/components/forms/CandidateForm.astro";
import Faq from "@/components/ui/Faq.astro";
import { CANDIDATE_FAQS } from "@/data/faqs";
import { SITE_CONFIG } from "@/site-config";
import { faqSchema } from "@/lib/schema";

const title = `For talent — Join our global network | ${SITE_CONFIG.brand}`;
const description =
  "Apply for specialist, operations, and leadership roles with global clients. Fair assessments and direct career opportunities.";

const BENEFITS = [
  {
    title: "Relevant roles",
    body: "Opportunities matched to your experience and goals.",
  },
  {
    title: "Fair assessment",
    body: "Show your ability through work relevant to the role.",
  },
  {
    title: "Clear process",
    body: "Know what the assessment covers and what happens next.",
  },
];

const jsonLd = [faqSchema(CANDIDATE_FAQS)];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Section tone="surface" bordered>
    <div
      class="grid gap-[clamp(3rem,7vw,6rem)] lg:grid-cols-[minmax(0,0.8fr)_minmax(30rem,1.2fr)]"
    >
      <div class="c27-rise lg:sticky lg:top-28 lg:self-start">
        <h1 class="c27-h1">Find your next role.</h1>
        <p class="c27-lede mt-5">
          Apply once. We contact you when your profile matches a relevant
          opportunity.
        </p>

        <div class="mt-9 border-t border-c27-line">
          {
            BENEFITS.map((benefit) => (
              <article class="border-b border-c27-line py-5">
                <h2 class="c27-card-title font-semibold">{benefit.title}</h2>
                <p class="mt-2 text-body-sm leading-relaxed text-c27-ink-2">
                  {benefit.body}
                </p>
              </article>
            ))
          }
        </div>

        <p
          class="c27-card-shadow mt-7 border border-c27-line bg-c27-tint-mint p-4 text-caption leading-relaxed text-c27-ink-2"
        >
          Some roles include overseas work. Availability and approvals depend on
          the role and client.
        </p>
      </div>

      <div class="c27-rise" style="--c27-d:80ms"><CandidateForm /></div>
    </div>
  </Section>

  <Section narrow>
    <SectionHead heading="FAQs" centered />
    <Faq items={CANDIDATE_FAQS} />
  </Section>
</Layout>
