---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import EmployerForm from "@/components/forms/EmployerForm.astro";
import Lifecycle from "@/components/sections/Lifecycle.astro";
import Faq from "@/components/ui/Faq.astro";
import { EMPLOYER_FAQS } from "@/data/faqs";
import { ROUTES, SITE_CONFIG } from "@/site-config";
import { breadcrumbSchema, faqSchema, serviceSchema } from "@/lib/schema";

const title = `Build your team | ${SITE_CONFIG.brand}`;
const description =
  "Share the roles, level, and location. Get a managed hiring plan for your team.";

const jsonLd = [
  breadcrumbSchema([{ name: "Build your team", path: ROUTES.hire }]),
  serviceSchema(),
  faqSchema(EMPLOYER_FAQS),
];

const EXPECTATIONS = [
  "One specialist or a complete team",
  "Role-specific assessment",
  "Security and leadership hiring",
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Section tone="violet" bordered>
    <div
      class="grid gap-[clamp(3rem,7vw,6rem)] lg:grid-cols-[minmax(0,0.8fr)_minmax(30rem,1.2fr)]"
    >
      <div class="c27-rise lg:sticky lg:top-28 lg:self-start">
        <h1 class="c27-h2">Tell us who you need.</h1>
        <p
          class="c27-lede mt-5 text-[clamp(1rem,1.4vw,1.125rem)] leading-relaxed"
        >
          Share the role, level, location, and target start.
        </p>
        <ul class="mt-8 border-t border-c27-line">
          {
            EXPECTATIONS.map((item) => (
              <li class="border-b border-c27-line py-3.5 text-body-sm leading-relaxed text-c27-ink-2">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="c27-rise" style="--c27-d:80ms"><EmployerForm /></div>
    </div>
  </Section>

  <Section tone="surface" bordered>
    <SectionHead
      heading="Support after the hire."
      lede="Onboarding and ongoing employee support stay covered."
    />
    <Lifecycle />
  </Section>

  <Section narrow>
    <SectionHead heading="Before you submit." />
    <Faq items={EMPLOYER_FAQS} />
  </Section>
</Layout>
