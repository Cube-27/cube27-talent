---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import EmployerForm from "@/components/forms/EmployerForm.astro";
import Lifecycle from "@/components/sections/Lifecycle.astro";
import Faq from "@/components/ui/Faq.astro";
import { EMPLOYER_FAQS } from "@/data/faqs";
import { SITE_CONFIG } from "@/site-config";
import { serviceSchema } from "@/lib/schema";

const title = `Build your team — Start a hiring conversation | ${SITE_CONFIG.brand}`;
const description =
  "Tell us how to reach you and, if useful, what you are hiring for. Start a conversation about assessed talent and managed team building.";

const jsonLd = [serviceSchema()];

const EXPECTATIONS = [
  "One specialist or a complete team",
  "Role-specific assessment",
  "Compliance and lifecycle support",
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Section
    class="c27-blueprint -mt-[4.5rem] pt-[calc(var(--c27-pad-section)+4.5rem)]"
  >
    <div
      class="grid gap-[clamp(3rem,7vw,6rem)] lg:grid-cols-[minmax(0,0.8fr)_minmax(30rem,1.2fr)]"
    >
      <div class="c27-rise lg:sticky lg:top-28 lg:self-start">
        <h1 class="c27-h1">Tell us who you need.</h1>
        <p class="c27-lede mt-5">
          Share three contact details. Add your requirement now if it is useful,
          or we can cover it together.
        </p>
        <ul class="mt-8 border-t border-c27-line">
          {
            EXPECTATIONS.map((item) => (
              <li class="border-b border-c27-line py-3.5 text-body-sm leading-relaxed text-c27-ink-2">
                {item}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="c27-rise" style="--c27-d:80ms"><EmployerForm /></div>
    </div>
  </Section>

  <Section tone="surface">
    <SectionHead
      heading="Support after the hire."
      lede="Onboarding and ongoing employee support stay covered."
    />
    <Lifecycle />
  </Section>

  <Section>
    <div class="c27-faq-split">
      <SectionHead heading="FAQs" align="stack" />
      <Faq items={EMPLOYER_FAQS} />
    </div>
  </Section>
</Layout>
