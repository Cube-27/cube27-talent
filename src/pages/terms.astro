---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import { SITE_CONFIG } from "@/site-config";

/**
 * PLACEHOLDER — NOT LEGALLY REVIEWED. noindex until approved.
 * Website and service-use terms, plan §11.
 */
const title = `Terms | ${SITE_CONFIG.brand}`;
---

<Layout title={title} description="Website and service-use terms." noindex>
  <Section narrow>
    <span class="c27-label mb-3 block">Legal</span>
    <h1 class="c27-h2">Terms</h1>
    <div
      class="mt-6 rounded-c27-sm border-l-2 border-c27-amber bg-c27-surface p-5 text-body-sm text-c27-ink-2"
    >
      <p class="font-semibold text-c27-ink">Draft — not yet approved.</p>
      <p class="mt-2">
        Website and service-use terms must be drafted against the approved
        contracting entity and the signed client agreement, then reviewed before
        launch. This page is excluded from search indexing until then.
      </p>
      <p class="mt-4">Contact: {SITE_CONFIG.organization.email}</p>
    </div>
  </Section>
</Layout>
