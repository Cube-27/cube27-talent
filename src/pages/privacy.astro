---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import { SITE_CONFIG } from "@/site-config";

/**
 * PLACEHOLDER — NOT LEGALLY REVIEWED.
 *
 * Plan §14.3 lists what this notice must state. It cannot launch until the
 * legal entity, retention period, deletion process and processor list are
 * approved (invariants: pending decisions). The page is noindex until then so
 * an unreviewed notice is never indexed or relied upon.
 */
const title = `Privacy notice | ${SITE_CONFIG.brand}`;

const required = [
  "The exact Cube27 legal entity and its privacy contact.",
  "Employer and candidate data collected, field by field.",
  "Purposes: recruitment, employment administration, communication, fraud prevention, attribution.",
  "Processors used — Cloudflare, Resend, and LinkedIn when its tag is enabled.",
  "Whether data is transferred internationally, and on what basis.",
  "The candidate-profile retention period, and how retention consent is withdrawn.",
  "How to request access, correction or deletion.",
  "That resumes are delivered to and retained in Cube27's internal email and recruitment systems.",
  "That separate consent is obtained before reference or background checks.",
];
---

<Layout
  title={title}
  description="How Cube27 Talent handles employer and candidate data."
  noindex
>
  <Section narrow>
    <span class="c27-label mb-3 block">Legal</span>
    <h1 class="c27-h2">Privacy notice</h1>

    <div
      class="mt-6 rounded-c27-sm border-l-2 border-c27-amber bg-c27-surface p-5 text-body-sm text-c27-ink-2"
    >
      <p class="font-semibold text-c27-ink">Draft — not yet approved.</p>
      <p class="mt-2">
        This page is a placeholder and is excluded from search indexing. It must
        be drafted and reviewed before launch, and must cover:
      </p>
      <ul class="mt-3 grid gap-1.5">
        {required.map((item) => <li>— {item}</li>)}
      </ul>
      <p class="mt-4">
        Interim contact for any data request: {
          SITE_CONFIG.organization.privacyEmail
        }
      </p>
    </div>
  </Section>
</Layout>
