---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import ExpertiseSelector from "@/components/sections/ExpertiseSelector.astro";
import SecurityTeams from "@/components/sections/SecurityTeams.astro";
import LeadershipHiring from "@/components/sections/LeadershipHiring.astro";
import FinalCta from "@/components/sections/FinalCta.astro";
import { ROUTES, SITE_CONFIG } from "@/site-config";
import { breadcrumbSchema } from "@/lib/schema";

const title = `Hiring expertise across tech, security, operations and leadership | ${SITE_CONFIG.brand}`;
const description =
  "Cross-functional talent spanning technology, product, cloud, data, security, operations, and leadership through CXO.";

const jsonLd = [
  breadcrumbSchema([{ name: "Expertise", path: ROUTES.expertise }]),
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Section tone="violet" bordered>
    <h1 class="c27-rise c27-display mx-auto max-w-none text-center">
      Hire across every critical function
    </h1>
    <p
      class="c27-rise c27-lede mx-auto mt-7 text-center text-[clamp(1.05rem,1.7vw,1.3rem)] leading-relaxed"
      style="--c27-d:80ms"
    >
      Specialists, security teams, operators, and executives.
    </p>
    <div class="mt-[clamp(3rem,6vw,5rem)]">
      <ExpertiseSelector headingLevel={2} />
    </div>
  </Section>

  <Section tone="sky" bordered>
    <SecurityTeams />
  </Section>

  <Section>
    <LeadershipHiring />
  </Section>

  <FinalCta
    heading="Build the capability you need"
    body="Tell us the function and seniority."
  />
</Layout>
