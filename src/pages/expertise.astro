---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import ExpertiseSelector from "@/components/sections/ExpertiseSelector.astro";
import SecurityTeams from "@/components/sections/SecurityTeams.astro";
import LeadershipHiring from "@/components/sections/LeadershipHiring.astro";
import AudienceSplit from "@/components/sections/AudienceSplit.astro";
import { ROUTES, SITE_CONFIG } from "@/site-config";
import { breadcrumbSchema } from "@/lib/schema";

const title = `Expertise | ${SITE_CONFIG.brand}`;
const description =
  "Engineering and product, cloud and infrastructure, data and AI, security and compliance, quality, design, and leadership up to CXO.";

const jsonLd = [
  breadcrumbSchema([{ name: "Expertise", path: ROUTES.expertise }]),
];
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Section>
    <span class="c27-label mb-3 block">Expertise</span>
    <h1 class="c27-h2">Whatever the team is missing</h1>
    <p class="c27-lede mt-4">
      We recruit where we can assess properly, which is a wider brief than it
      sounds. Assessment is always matched to the discipline — an SRE, a
      compliance lead and a product designer do not sit the same test.
    </p>
    <div class="mt-10"><ExpertiseSelector headingLevel={2} /></div>
  </Section>

  {
    /* Invariant rule 0.3: no out-of-scope list. Requirements we cannot serve
      are declined in conversation, not pre-empted on the website. */
  }

  <Section tone="surface" bordered>
    <SecurityTeams />
  </Section>

  <Section>
    <LeadershipHiring />
  </Section>

  <Section tone="surface" bordered>
    <SectionHead label="Two ways in" heading="Hiring, or looking?" />
    <AudienceSplit />
  </Section>
</Layout>
