---
import Layout from "@/layouts/Layout.astro";
import Section from "@/components/ui/Section.astro";
import Button from "@/components/ui/Button.astro";
import { ROUTES, SITE_CONFIG } from "@/site-config";
---

<Layout
  title={`Page not found | ${SITE_CONFIG.brand}`}
  description="Page not found."
  noindex
>
  <Section narrow tone="surface" bordered>
    <p class="font-display text-body-sm font-semibold text-c27-accent">404</p>
    <h1 class="c27-h1 mt-4">This page isn’t here.</h1>
    <p class="c27-lede mt-5">
      The link may be out of date. Use one of the working routes below.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <Button href={ROUTES.hire} variant="primary" arrow>Build your team</Button
      >
      <Button href={ROUTES.join} variant="line">For talent</Button>
    </div>
  </Section>
</Layout>
