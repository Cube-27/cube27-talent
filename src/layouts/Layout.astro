---
import "@/styles/globals.css";
import Seo from "@/components/Seo.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import { SITE_CONFIG } from "@/site-config";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Suppresses the announcement bar on confirmation pages. */
  bare?: boolean;
}

const {
  title = SITE_CONFIG.name,
  description = SITE_CONFIG.description,
  canonical,
  noindex = false,
  jsonLd,
  bare = false,
} = Astro.props;

const site = Astro.site;
const canonicalUrl = canonical
  ? new URL(canonical, site).toString()
  : site
    ? new URL(Astro.url.pathname, site).toString()
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/cube27-logo.png" />
    <meta name="theme-color" content="#0b192c" />
    <meta name="generator" content="Astro" />

    {/* Both faces are used above the fold, so both are preloaded. */}
    <link
      rel="preload"
      href="/fonts/satoshi-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/switzer-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <Seo
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      noindex={noindex}
      jsonLd={jsonLd}
    />

    {
      /* Marks the document as JS-capable before first paint, so the reveal
         classes only hide content when the observer can reveal it again.
         Without this a JS failure leaves the page blank. */
    }
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only absolute left-4 top-4 z-[100] rounded-c27-sm bg-c27-surface px-4 py-2 font-semibold text-c27-ink shadow-c27-lg focus:not-sr-only"
      >Skip to content</a
    >

    <Header bare={bare} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />

    <script>
      // Scroll reveal. Elements opt in with `.c27-rise` and stagger with
      // `style="--c27-d: 90ms"`. Unobserved after first reveal so scrolling
      // back up does not re-run the transition.
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            entry.target.classList.add("in");
            observer.unobserve(entry.target);
          }
        },
        { rootMargin: "0px 0px -8%" },
      );
      for (const el of document.querySelectorAll(".c27-rise")) {
        observer.observe(el);
      }

      // Header gains a hairline once the page scrolls off the top.
      const header = document.getElementById("site-header");
      if (header) {
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            header.classList.toggle("is-stuck", window.scrollY > 8);
            ticking = false;
          });
        };
        onScroll();
        window.addEventListener("scroll", onScroll, { passive: true });
      }
    </script>
  </body>
</html>
