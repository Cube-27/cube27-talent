---
import "@/styles/globals.css";
import Seo from "@/components/Seo.astro";
import Header from "@/components/sections/Header.astro";
import Footer from "@/components/sections/Footer.astro";
import { INDEXING_ENABLED, SITE_CONFIG } from "@/site-config";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Uses the identity-only header on confirmation pages. */
  bare?: boolean;
}

const {
  title = SITE_CONFIG.name,
  description = SITE_CONFIG.description,
  canonical,
  noindex = false,
  jsonLd,
  bare = false,
} = Astro.props;

// Cloudflare Pages sets CF_PAGES_BRANCH at build time. Any branch other than the
// production branch (main) is a preview deployment on *.pages.dev and must never
// be indexed, regardless of the per-page noindex prop.
const previewBranch = process.env.CF_PAGES_BRANCH;
const isPreviewDeploy = Boolean(previewBranch) && previewBranch !== "main";

const site = Astro.site;
const canonicalUrl = canonical
  ? new URL(canonical, site).toString()
  : site
    ? new URL(Astro.url.pathname, site).toString()
    : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    {/* Matches the neutral hero surface. */}
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content="Astro" />

    {
      /* Geist and DM Sans variable faces are preloaded for fast first paint without layout shift. */
    }
    <link
      rel="preload"
      href="/fonts/geist-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preconnect"
      href="https://challenges.cloudflare.com"
      crossorigin
    />

    <Seo
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      noindex={noindex || isPreviewDeploy || !INDEXING_ENABLED}
      jsonLd={jsonLd}
    />

    {
      /* `js` means scripting is on, so CSS can leave progressively-enhanced
         content collapsed instead of painting it and letting JS snap it away.

         The scroll-reveal marker is deliberately NOT set here. Chrome ignores
         an element that is `opacity: 0` at first paint as an LCP candidate and
         does not reconsider it when it fades in, so hiding the first screen
         before paint left the page with no LCP at all. `reveal` is now added
         by the module below, after it has marked everything already on screen
         as revealed. */
    }
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only absolute left-4 top-4 z-[100] bg-c27-surface px-4 py-2 font-semibold text-c27-ink shadow-c27-overlay focus:not-sr-only"
      >Skip to content</a
    >

    <Header bare={bare} />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />

    <script>
      // Scroll reveal. Elements opt in with `.c27-rise` and stagger with
      // `style="--c27-d: 90ms"`. Unobserved after first reveal so scrolling
      // back up does not re-run the transition.
      if ("IntersectionObserver" in window) {
        const rise = document.querySelectorAll(".c27-rise");

        // Anything already on screen is marked revealed BEFORE the hidden
        // state is switched on, so the first screen is never painted at
        // opacity 0 — that is what preserves the LCP candidate. Elements
        // below the fold are off screen, so gaining the hidden state after
        // first paint is invisible.
        for (const el of rise) {
          if (el.getBoundingClientRect().top < window.innerHeight) {
            el.classList.add("in");
          }
        }

        document.documentElement.classList.add("reveal");

        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add("in");
              observer.unobserve(entry.target);
            }
          },
          { rootMargin: "0px 0px -8%" },
        );
        for (const el of rise) {
          if (!el.classList.contains("in")) observer.observe(el);
        }
      }

      // A scroll listener toggling `is-stuck` on the header used to live here.
      // No stylesheet ever defined that class, and the header carries its
      // hairline unconditionally, so it ran on every page and every scroll
      // frame to no effect. Removed rather than given a rule: the sticky
      // header reads fine without a state change.
    </script>
  </body>
</html>
