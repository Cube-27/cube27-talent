---
/**
 * Inline SVG icon set. Kept as one file so stroke weight and viewBox stay
 * consistent — no icon library dependency (plan §12.4.5).
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = "" } = Astro.props;

const PATHS: Record<string, string> = {
  code: '<path d="M9 7l-5 5 5 5M15 7l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  phone:
    '<rect x="6" y="2.5" width="12" height="19" rx="2.5" stroke="currentColor" stroke-width="2"/><path d="M10.5 18.5h3" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  check:
    '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2"/><path d="M8 12.3l2.6 2.6L16 9.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  cloud:
    '<path d="M6.5 16.5a4 4 0 011-7.9 5.5 5.5 0 0110.6 1.5 3.7 3.7 0 01-.6 6.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M12 12v8m0-8l-2.4 2.4M12 12l2.4 2.4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  board:
    '<rect x="3.5" y="4.5" width="17" height="15" rx="2.5" stroke="currentColor" stroke-width="2"/><path d="M3.5 9.5h17M9 19.5v-10" stroke="currentColor" stroke-width="2"/>',
  pen: '<path d="M4 16.5L15 5.5l3.5 3.5L7.5 20H4v-3.5z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>',
  doc: '<rect x="4" y="3.5" width="16" height="17" rx="2.5" stroke="currentColor" stroke-width="2"/><path d="M8 9h8M8 13h8M8 17h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  cart: '<path d="M4 6h2.2l2 10h9.4l2-7.5H7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="19.5" r="1.5" fill="currentColor"/><circle cx="17" cy="19.5" r="1.5" fill="currentColor"/>',
  shield:
    '<path d="M12 3l7.5 3v6c0 4.4-3 8.2-7.5 9.4C7.5 20.2 4.5 16.4 4.5 12V6L12 3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 12.2l2 2 4-4.4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>',
  person:
    '<circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4.5 20c1.5-3.6 4.2-5.4 7.5-5.4S18 16.4 19.5 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  target:
    '<circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="3.5" stroke="currentColor" stroke-width="1.8"/><path d="M12 3.5V1.8M20.5 12h1.7M12 20.5v1.7M3.5 12H1.8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  search:
    '<circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="2"/><path d="M15.4 15.4L21 21" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>',
  chat: '<path d="M4 5.5A2.5 2.5 0 016.5 3h11A2.5 2.5 0 0120 5.5v8a2.5 2.5 0 01-2.5 2.5H10l-5 4v-4.6A2.5 2.5 0 014 13V5.5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 8h8M8 12h5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  users:
    '<circle cx="9" cy="8" r="3" stroke="currentColor" stroke-width="1.8"/><circle cx="17" cy="9" r="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M3.5 19c.8-3.4 2.7-5.1 5.5-5.1s4.7 1.7 5.5 5.1M14 14.6c.8-.5 1.8-.7 2.8-.7 2.2 0 3.8 1.4 4.4 4.1" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  briefcase:
    '<rect x="3" y="7" width="18" height="13" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M8.5 7V5.5A1.5 1.5 0 0110 4h4a1.5 1.5 0 011.5 1.5V7M3 12.5c5.2 2 12.8 2 18 0M10 13.5h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  compass:
    '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M15.8 8.2l-2.1 5.5-5.5 2.1 2.1-5.5 5.5-2.1z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>',
  chart:
    '<path d="M4 20V4M4 20h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M8 20v-5.5M12.5 20V9M17 20v-8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  lock: '<rect x="4.5" y="10" width="15" height="10.5" rx="2.5" stroke="currentColor" stroke-width="1.8"/><path d="M8 10V7.5a4 4 0 018 0V10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>',
  spark:
    '<path d="M12 3l1.9 5.6L19.5 10l-5.6 1.9L12 17.5l-1.9-5.6L4.5 10l5.6-1.4L12 3z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M18.5 16l.7 2 2 .7-2 .7-.7 2-.7-2-2-.7 2-.7.7-2z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>',
};

const path = PATHS[name] ?? PATHS.check;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  aria-hidden="true"
  class={className}
  set:html={path}
/>
