---
import Icon from "@/components/ui/Icon.astro";
import CheckMark from "@/components/ui/CheckMark.astro";

/**
 * The candidate snapshot template — the hero visual.
 *
 * INVARIANT 18: this is a structural template, never a live candidate. The
 * "Template" badge and the "Not a live candidate" line are not optional and
 * must not be removed to make the card look more convincing.
 *
 * INVARIANT RULE 0.1: no company name anywhere in this card.
 *
 * Flat rebuild: no shadow, no gradient, no hover glow. Depth comes from the
 * tint step between the white card and the sections inside it.
 */

const ROWS = [
  { label: "Assessment", w: "84%", delay: "200ms" },
  { label: "Communication", w: "76%", delay: "340ms" },
  { label: "References", w: "100%", delay: "480ms" },
];
---

<figure
  class="relative z-[2] overflow-hidden rounded-c27-lg border border-c27-line bg-c27-surface"
>
  <div class="flex items-center gap-3.5 border-b border-c27-line p-5">
    <span
      class="grid size-10 shrink-0 place-items-center rounded-c27-sm bg-c27-accent-soft text-c27-accent-d"
    >
      <Icon name="person" size={20} />
    </span>
    <span>
      <b
        class="block font-display text-body-sm font-bold tracking-[-0.02em] text-c27-ink"
        >Senior Backend Engineer</b
      >
      <small class="font-mono text-caption text-c27-ink-3"
        >Candidate snapshot</small
      >
    </span>
    <span
      class="ml-auto shrink-0 rounded-full border border-c27-line bg-c27-surface-2 px-2.5 py-1 text-micro font-bold uppercase tracking-[0.1em] text-c27-ink-2"
      >Template</span
    >
  </div>

  <div class="grid grid-cols-2 gap-2.5 px-5 pb-3.5 pt-[1.1rem]">
    <div class="rounded-c27-sm bg-c27-surface-2 px-3.5 py-2.5">
      <span class="block text-caption text-c27-ink-2">Screen</span>
      <b class="mt-0.5 block text-body-sm font-bold text-c27-ink">Passed</b>
    </div>
    <div class="rounded-c27-sm bg-c27-accent-soft px-3.5 py-2.5">
      <span class="block text-caption text-c27-accent-d">Interview</span>
      <b class="mt-0.5 block text-body-sm font-bold text-c27-accent-d"
        >Recommended</b
      >
    </div>
  </div>

  <div class="grid gap-3 px-5 pb-4">
    {
      ROWS.map((row) => (
        <div class="grid grid-cols-[6.75rem_minmax(0,1fr)] items-center gap-3 text-caption text-c27-ink-2">
          <span>{row.label}</span>
          <span class="h-1.5 overflow-hidden rounded-full bg-c27-surface-2">
            <i
              class="block h-full origin-left rounded-full bg-c27-accent motion-safe:animate-[c27-fill_900ms_var(--c27-ease)_both]"
              style={`width:${row.w};animation-delay:${row.delay}`}
            />
          </span>
        </div>
      ))
    }
  </div>

  <p
    class="mx-5 mb-[1.1rem] rounded-c27-sm bg-c27-tint-mint px-3.5 py-3 text-caption leading-relaxed text-c27-ink-2"
  >
    <b
      class="mb-1 flex items-center gap-1.5 text-caption font-bold text-c27-ink"
    >
      <Icon name="spark" size={14} class="text-c27-ink" />
      Assessment recorded
    </b>
    Every profile carries the same structure — the recorded assessment, the interview
    recommendation, the known gaps and availability. Not a live candidate.
  </p>

  <figcaption
    class="flex items-center justify-between gap-4 border-t border-c27-line bg-c27-surface-2 px-5 py-3.5 text-caption text-c27-ink-2"
  >
    <span class="inline-flex items-center gap-1.5 font-bold text-c27-accent-d">
      <CheckMark size={15} />
      References verified
    </span>
    <span>30-day notice &middot; full-time</span>
  </figcaption>
</figure>

<style is:global>
  @keyframes c27-fill {
    from {
      transform: scaleX(0);
    }
  }
</style>
