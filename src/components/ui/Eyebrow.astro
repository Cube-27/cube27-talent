---
/**
 * The uppercase label that names the field a section sits in.
 *
 * A solid terracotta square opens it — the system's "signal flag". One per
 * section, never more, and never a sentence: an eyebrow is two or three
 * words, optionally joined by a middot.
 */
export interface Props {
  as?: "p" | "div" | "span";
  class?: string;
}

const { as: Tag = "p", class: className = "" } = Astro.props;
---

<Tag class:list={["c27-label", className]}>
  <slot />
</Tag>
