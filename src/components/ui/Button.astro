---
/**
 * The only button in the system. Design system §6.1.
 * Variants carry meaning: primary = employer action, blue = candidate action.
 */
interface Props {
  href?: string;
  type?: "button" | "submit";
  variant?: "primary" | "blue" | "line" | "line-invert";
  size?: "md" | "sm";
  arrow?: boolean;
  class?: string;
  id?: string;
  disabled?: boolean;
}

const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  arrow = false,
  class: className = "",
  id,
  disabled = false,
} = Astro.props;

const base =
  "group inline-flex items-center gap-2.5 whitespace-nowrap rounded-c27-sm border font-display font-bold no-underline cursor-pointer transition-[background-color,border-color,color,transform,box-shadow] duration-200 ease-[var(--c27-ease)] motion-safe:hover:-translate-y-px active:translate-y-0 disabled:cursor-not-allowed disabled:opacity-60 disabled:pointer-events-none";

const variants = {
  // green-d, not green: white on #10b45f is 2.72:1 and fails WCAG AA outright.
  // This is 5.48:1, and the hover step keeps going darker rather than lighter.
  primary:
    "border-transparent bg-c27-green-d text-white shadow-c27-sm hover:bg-c27-green-dd hover:shadow-[0_8px_20px_-6px_rgb(4_120_87/0.45)]",
  blue: "border-transparent bg-c27-blue text-white shadow-c27-sm hover:bg-c27-blue-d hover:shadow-[0_8px_20px_-6px_rgba(37,99,235,0.45)]",
  line: "border-c27-line bg-c27-surface text-c27-ink shadow-c27-sm hover:border-c27-blue hover:text-c27-blue-d hover:bg-c27-tint-2",
  "line-invert":
    "border-white/30 bg-white/5 text-white backdrop-blur-xs hover:border-white hover:bg-white/15",
};

// min-h-11 keeps every button at the 44px tap-target floor (§8)
const sizes = {
  md: "min-h-12 px-5.5 py-3 text-[0.9375rem]",
  sm: "min-h-11 px-4.5 py-2.5 text-[0.875rem]",
};

const cls = `${base} ${variants[variant]} ${sizes[size]} ${className}`;
---

{
  href ? (
    <a href={href} class={cls} id={id}>
      <slot />
      {arrow && (
        <span class="font-mono transition-transform duration-200 group-hover:translate-x-1.5">
          &rarr;
        </span>
      )}
    </a>
  ) : (
    <button type={type} class={cls} id={id} disabled={disabled}>
      <slot />
      {arrow && (
        <span class="font-mono transition-transform duration-200 group-hover:translate-x-1.5">
          &rarr;
        </span>
      )}
    </button>
  )
}
