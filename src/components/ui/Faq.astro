---
import type { Faq } from "@/data/faqs";

interface Props {
  items: Faq[];
}
const { items } = Astro.props;
const groupName = `faq-${crypto.randomUUID()}`;
---

{/* Native <details> — accessible and functional with no JS. */}
<div class="c27-rise border-y border-c27-line">
  {
    items.map((item, i) => (
      <details
        name={groupName}
        open={i === 0}
        class="border-b border-c27-line last:border-b-0"
      >
        <summary class="flex min-h-16 cursor-pointer list-none items-center justify-between gap-5 py-5 font-display font-semibold leading-snug tracking-[-0.015em] text-c27-ink transition-colors hover:text-c27-accent-d [&::-webkit-details-marker]:hidden">
          {item.q}
          <span
            class="relative size-6 shrink-0 text-c27-accent"
            aria-hidden="true"
          />
        </summary>
        <p class="max-w-[70ch] pb-6 pr-12 text-body-sm leading-relaxed text-c27-ink-2">
          {item.a}
        </p>
      </details>
    ))
  }
</div>

<style>
  summary span::before,
  summary span::after {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 0.875rem;
    height: 1.5px;
    content: "";
    background: currentColor;
    transform: translate(-50%, -50%);
    transition:
      opacity var(--c27-dur-fast) ease,
      transform var(--c27-dur-fast) var(--c27-ease);
  }

  summary span::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] summary {
    color: var(--c27-accent-d);
  }

  details[open] summary span::after {
    opacity: 0;
    transform: translate(-50%, -50%) rotate(0deg);
  }
</style>
