---
import type { Faq } from "@/data/faqs";

interface Props {
  items: Faq[];
}
const { items } = Astro.props;
---

{/* Native <details> — accessible and functional with no JS. §6.9. */}
<div class="c27-rise grid gap-2.5" data-faq>
  {
    items.map((item, i) => (
      <details
        open={i === 0}
        class="rounded-c27 border border-c27-line bg-c27-surface shadow-c27-lg transition-colors open:border-[#c3d5ff]"
      >
        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3.5 font-display font-bold leading-snug tracking-[-0.015em] [&::-webkit-details-marker]:hidden">
          {item.q}
          <span
            class="grid size-7 shrink-0 place-items-center rounded-full bg-c27-blue-soft font-mono text-lg leading-none text-c27-blue transition-colors"
            aria-hidden="true"
          >
            +
          </span>
        </summary>
        <p class="max-w-[70ch] px-5 pb-5 text-body-sm text-c27-ink-2">
          {item.a}
        </p>
      </details>
    ))
  }
</div>

<script>
  // Exclusive disclosure is done here rather than with the `name` attribute:
  // a name is document-wide, so two Faq blocks on one page would group into
  // each other. Scoping to [data-faq] keeps each block independent.
  for (const root of document.querySelectorAll<HTMLElement>("[data-faq]")) {
    const items = [...root.querySelectorAll<HTMLDetailsElement>("details")];
    for (const item of items) {
      item.addEventListener("toggle", () => {
        if (!item.open) return;
        for (const sibling of items) {
          if (sibling !== item) sibling.removeAttribute("open");
        }
      });
    }
  }
</script>

<style>
  details[open] summary span {
    visibility: hidden;
    position: relative;
  }
  details[open] summary span::after {
    content: "–";
    visibility: visible;
    position: absolute;
    inset: 0;
  }

  details[open] summary span {
    background: var(--c27-blue);
    color: white;
  }
</style>
