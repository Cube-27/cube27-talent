---
/**
 * Section shell. Owns all vertical rhythm and background tone so no page file
 * sets its own padding.
 *
 * A section is a colour field and nothing else — never a border box, never a
 * shadow. Separation between sections is a step in tone.
 */
interface Props {
  id?: string;
  tone?: "ground" | "surface" | "deep";
  narrow?: boolean;
  class?: string;
}

const {
  id,
  tone = "ground",
  narrow = false,
  class: className = "",
} = Astro.props;

const tones = {
  ground: "bg-c27-ground",
  surface: "bg-c27-surface-2",
  deep: "bg-c27-deep text-c27-on-deep",
};
---

<section
  id={id}
  class:list={["py-[var(--c27-pad-section)]", tones[tone], className]}
>
  <div class={narrow ? "c27-wrap-narrow" : "c27-wrap"}>
    <slot />
  </div>
</section>
