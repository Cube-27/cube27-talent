---
/**
 * Section shell. Owns all vertical rhythm and background tone so no page file
 * sets its own padding. Design system §6.2.
 */
interface Props {
  id?: string;
  tone?: "ground" | "surface" | "tint" | "dark";
  bordered?: boolean;
  narrow?: boolean;
  class?: string;
}

const {
  id,
  tone = "ground",
  bordered = false,
  narrow = false,
  class: className = "",
} = Astro.props;

const tones = {
  ground: "bg-c27-ground",
  surface: "bg-c27-surface",
  tint: "bg-c27-tint-2",
  dark: "c27-navy-field text-white",
};
---

<section
  id={id}
  class:list={[
    "py-[var(--c27-pad-section)]",
    tones[tone],
    bordered && "border-y",
    bordered && (tone === "dark" ? "border-transparent" : "border-c27-line"),
    className,
  ]}
>
  <div class={narrow ? "c27-wrap-narrow" : "c27-wrap"}>
    <slot />
  </div>
</section>
