---
/**
 * Label → h2 → optional lede. Every content section opens with one.
 * Design system §6.3. Headings are third person — no "we"/"you" (§1.4).
 */
interface Props {
  label: string;
  heading: string;
  lede?: string;
  invert?: boolean;
}

const { label, heading, lede, invert = false } = Astro.props;
---

<div class="c27-rise mb-[clamp(2.25rem,4.5vw,3.25rem)] max-w-[42rem]">
  <span
    class:list={[
      "c27-label mb-3 inline-flex items-center gap-2",
      invert ? "text-c27-on-navy-accent" : "text-c27-blue",
    ]}
  >
    <i
      class:list={[
        "size-1.5 rounded-full",
        invert ? "bg-c27-on-navy-accent" : "bg-c27-blue",
      ]}></i>
    {label}
  </span>
  <h2 class:list={["c27-h2 tracking-tight", invert && "text-white"]}>
    {heading}
  </h2>
  {
    lede && (
      <p
        class:list={[
          "c27-lede mt-3.5 text-body",
          invert && "text-c27-on-navy-2",
        ]}
      >
        {lede}
      </p>
    )
  }
</div>
