---
interface Props {
  heading: string;
  lede?: string;
  invert?: boolean;
  centered?: boolean;
}

const { heading, lede, invert = false, centered = false } = Astro.props;
---

<div
  class:list={[
    "c27-rise mb-[clamp(2.5rem,5vw,4rem)] max-w-[52rem]",
    centered && "mx-auto text-center",
  ]}
>
  <h2
    class:list={["c27-h2", invert && "text-c27-on-deep", centered && "mx-auto"]}
  >
    {heading}
  </h2>
  {
    lede && (
      <p
        class:list={[
          "c27-lede mt-5 text-[clamp(1rem,1.4vw,1.125rem)] leading-relaxed",
          invert && "text-c27-on-deep-2",
          centered && "mx-auto",
        ]}
      >
        {lede}
      </p>
    )
  }
</div>
