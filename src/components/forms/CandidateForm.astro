---
import Button from "@/components/ui/Button.astro";
import { ROLE_FAMILIES } from "@/data/roles";
import Select from "@/components/ui/Select.astro";
import { ENDPOINTS, ROUTES, TURNSTILE_SITE_KEY } from "@/site-config";

const siteKey = TURNSTILE_SITE_KEY;
const AVAILABILITY = [
  "Immediately",
  "Within 30 days",
  "30–60 days",
  "60–90 days",
  "Just exploring",
];
const WORK_PREFERENCE = ["Remote", "Hybrid", "Onsite", "Flexible"];
const RELOCATION = ["Yes", "No", "Depends on the opportunity"];

// h-12 matches the Select so inputs and dropdowns line up in the same row.
// The textarea takes the base without a fixed height.
const fieldBase =
  "w-full rounded-c27-sm border border-c27-line bg-c27-surface px-3.5 py-2.5 text-body-sm transition-shadow focus:border-c27-accent focus:outline-none focus:ring-[3px] focus:ring-c27-accent/15";
const field = `h-12 ${fieldBase}`;
const fieldArea = `${fieldBase} min-h-[5rem] resize-y`;
---

<form
  id="candidate-form"
  method="post"
  action={ENDPOINTS.candidateApplication}
  enctype="multipart/form-data"
  novalidate
  class="grid gap-4 rounded-c27-lg border border-c27-line bg-c27-surface p-[clamp(1.5rem,3vw,2.25rem)]"
>
  <div
    id="candidate-errors"
    role="alert"
    hidden
    tabindex="-1"
    class="rounded-c27-sm border-l-2 border-c27-danger bg-c27-danger-soft px-4 py-3 text-caption text-c27-danger"
  >
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-name" class="text-caption font-semibold">Full name</label>
      <input
        id="cf-name"
        name="name"
        type="text"
        required
        maxlength="100"
        autocomplete="name"
        class={field}
      />
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-email" class="text-caption font-semibold">Email</label>
      <input
        id="cf-email"
        name="email"
        type="email"
        required
        maxlength="320"
        autocomplete="email"
        class={field}
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-phone" class="text-caption font-semibold"
        >Phone, with country code</label
      >
      <input
        id="cf-phone"
        name="phone"
        type="tel"
        required
        maxlength="50"
        autocomplete="tel"
        placeholder="+91 98765 43210"
        class={field}
      />
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-location" class="text-caption font-semibold"
        >City and country</label
      >
      <input
        id="cf-location"
        name="location"
        type="text"
        required
        maxlength="120"
        placeholder="Pune, India"
        class={field}
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-family" class="text-caption font-semibold"
        >Role family</label
      >
      <Select id="cf-family" name="roleFamily" required>
        <option value="" disabled selected>Select…</option>
        {ROLE_FAMILIES.map((f) => <option value={f.id}>{f.name}</option>)}
      </Select>
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-role" class="text-caption font-semibold">Target role</label
      >
      <input
        id="cf-role"
        name="roleTitle"
        type="text"
        required
        maxlength="120"
        placeholder="Senior Backend Engineer"
        class={field}
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-[minmax(0,2fr)_minmax(0,1fr)]">
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-skills" class="text-caption font-semibold"
        >Core skills</label
      >
      <input
        id="cf-skills"
        name="skills"
        type="text"
        required
        maxlength="300"
        placeholder="Go, PostgreSQL, Kubernetes"
        class={field}
      />
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-exp" class="text-caption font-semibold"
        >Years of experience</label
      >
      <input
        id="cf-exp"
        name="experience"
        type="number"
        required
        min="0"
        max="60"
        step="1"
        class={field}
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-linkedin" class="text-caption font-semibold">
        LinkedIn <span class="font-normal text-c27-ink-3">— optional</span>
      </label>
      <input
        id="cf-linkedin"
        name="linkedin"
        type="url"
        maxlength="300"
        placeholder="https://www.linkedin.com/in/…"
        class={field}
      />
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-github" class="text-caption font-semibold">
        GitHub or portfolio
        <span class="font-normal text-c27-ink-3">— optional</span>
      </label>
      <input
        id="cf-github"
        name="github"
        type="url"
        maxlength="300"
        placeholder="https://github.com/…"
        class={field}
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-avail" class="text-caption font-semibold"
        >Availability</label
      >
      <Select id="cf-avail" name="availability" required>
        <option value="" disabled selected>Select…</option>
        {AVAILABILITY.map((a) => <option>{a}</option>)}
      </Select>
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-work" class="text-caption font-semibold"
        >Work preference</label
      >
      <Select id="cf-work" name="workPreference" required>
        <option value="" disabled selected>Select…</option>
        {WORK_PREFERENCE.map((w) => <option>{w}</option>)}
      </Select>
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="cf-reloc" class="text-caption font-semibold"
        >Open to relocation</label
      >
      <Select id="cf-reloc" name="relocation" required>
        <option value="" disabled selected>Select…</option>
        {RELOCATION.map((r) => <option>{r}</option>)}
      </Select>
    </div>
  </div>

  <div class="grid min-w-0 gap-1.5">
    <label for="cf-resume" class="text-caption font-semibold"
      >Resume — PDF or DOCX, up to 5 MB</label
    >
    <input
      id="cf-resume"
      name="resume"
      type="file"
      required
      accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      class="h-12 w-full rounded-c27-sm border border-c27-line bg-c27-surface px-3.5 py-2.5 text-body-sm file:mr-3 file:rounded file:border-0 file:bg-c27-accent-soft file:px-3 file:py-1.5 file:text-caption file:font-semibold file:text-c27-ink"
    />
  </div>

  <div class="grid min-w-0 gap-1.5">
    <label for="cf-note" class="text-caption font-semibold">
      Anything else <span class="font-normal text-c27-ink-3">— optional</span>
    </label>
    <textarea id="cf-note" name="note" maxlength="1500" class={fieldArea}
    ></textarea>
  </div>

  {
    /* Two separate consents. The retention consent is unticked by default and
       must never be bundled into the first one. Plan §9.2. */
  }
  <label
    class="grid grid-cols-[1.1rem_minmax(0,1fr)] items-start gap-2.5 text-caption text-c27-ink-2"
  >
    <input
      type="checkbox"
      name="consent"
      required
      value="yes"
      class="mt-1 accent-[var(--c27-accent)]"
    />
    <span>
      We may process this profile for recruitment, as described in the
      <a
        href={ROUTES.privacy}
        class="text-c27-accent-d underline underline-offset-2">privacy notice</a
      >.
    </span>
  </label>

  <label
    class="grid grid-cols-[1.1rem_minmax(0,1fr)] items-start gap-2.5 text-caption text-c27-ink-2"
  >
    <input
      type="checkbox"
      name="retentionConsent"
      value="yes"
      class="mt-1 accent-[var(--c27-accent)]"
    />
    <span>
      Optional: keep this profile on file for future suitable opportunities.
    </span>
  </label>

  <div
    aria-hidden="true"
    class="absolute left-[-9999px] h-0 w-0 overflow-hidden"
  >
    <label for="cf-website">Website</label>
    <input
      id="cf-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <input type="hidden" name="landingPage" />
  <input type="hidden" name="referrer" />
  <input type="hidden" name="utmSource" />
  <input type="hidden" name="utmMedium" />
  <input type="hidden" name="utmCampaign" />
  <input type="hidden" name="utmContent" />
  <input type="hidden" name="utmTerm" />

  {
    siteKey && (
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-theme="light"
        data-action="candidate-application"
      />
    )
  }

  <div class="flex flex-wrap items-center gap-3">
    <Button
      type="submit"
      variant="primary"
      arrow
      id="candidate-submit"
      disabled={!siteKey}>Send application</Button
    >
    <p
      id="candidate-status"
      role="status"
      aria-live="polite"
      class="text-caption text-c27-ink-2"
    >
    </p>
  </div>

  <p class="text-caption text-c27-ink-3">
    Submitting a profile does not guarantee screening, an interview, employment
    or an assignment.
  </p>
</form>

{
  siteKey && (
    <script
      is:inline
      async
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    />
  )
}

<script>
  import { attachFormHandler } from "@/lib/form-client";

  attachFormHandler({
    formId: "candidate-form",
    submitId: "candidate-submit",
    statusId: "candidate-status",
    errorsId: "candidate-errors",
    redirectTo: "/thank-you/candidate/",
  });
</script>
