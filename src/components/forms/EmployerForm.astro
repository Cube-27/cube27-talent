---
import Button from "@/components/ui/Button.astro";
import { ROLE_FAMILIES } from "@/data/roles";
import Select from "@/components/ui/Select.astro";
import Turnstile from "@/components/ui/Turnstile.astro";
import { ENDPOINTS, ROUTES, TURNSTILE_SITE_KEY } from "@/site-config";

const siteKey = TURNSTILE_SITE_KEY;
const HIRE_COUNTS = ["1", "2–5", "6–10", "11–25", "25+"];
const START_WINDOWS = [
  "As soon as possible",
  "Within 30 days",
  "1–3 months",
  "Planning ahead",
];
const ENGAGEMENTS = ["Full-time employment", "Either", "Contract"];
const ARRANGEMENTS = ["Remote", "Hybrid", "Onsite", "Relocation", "Flexible"];
---

<form
  id="employer-form"
  method="post"
  action={ENDPOINTS.employerLead}
  novalidate
  class="c27-form-shell grid gap-6"
>
  <noscript>
    <p
      class="border border-c27-line bg-c27-surface-2 px-4 py-3 text-caption leading-relaxed text-c27-ink-2"
    >
      Submitting this form needs JavaScript. With it turned off, email
      <a
        href="mailto:talent@cube27.com"
        class="text-c27-accent-d underline underline-offset-2"
        >talent@cube27.com</a
      > with the roles you are hiring for. That reaches the same team, though we may
      need to follow up for the details this form would have captured.
    </p>
  </noscript>

  {/* Error summary receives focus on failed validation. §6.8. */}
  <div
    id="form-errors"
    role="alert"
    hidden
    tabindex="-1"
    class="border border-c27-danger bg-c27-danger-soft px-4 py-3 text-caption text-c27-danger"
  >
  </div>

  <p class="text-caption text-c27-ink-3">
    <span class="text-c27-accent font-bold" aria-hidden="true">*</span> Required fields
  </p>

  <div class="c27-form-row grid sm:grid-cols-2">
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-name" class="text-caption font-semibold">
        Name <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <input
        id="ef-name"
        name="name"
        type="text"
        required
        maxlength="100"
        autocomplete="name"
        placeholder="Priya Raghavan"
        class="c27-field h-12"
      />
    </div>
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-email" class="text-caption font-semibold">
        Work email <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <input
        id="ef-email"
        name="email"
        type="email"
        required
        maxlength="320"
        autocomplete="email"
        placeholder="you@company.com"
        class="c27-field h-12"
      />
    </div>
  </div>

  <div class="c27-form-row grid sm:grid-cols-2">
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-company" class="text-caption font-semibold">
        Company <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <input
        id="ef-company"
        name="company"
        type="text"
        required
        maxlength="200"
        autocomplete="organization"
        placeholder="Company name"
        class="c27-field h-12"
      />
    </div>
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-title" class="text-caption font-semibold">
        Job title <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <input
        id="ef-title"
        name="jobTitle"
        type="text"
        required
        maxlength="120"
        autocomplete="organization-title"
        placeholder="VP Engineering"
        class="c27-field h-12"
      />
    </div>
  </div>

  <div class="c27-form-row grid sm:grid-cols-3">
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-country" class="text-caption font-semibold">
        Country <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <input
        id="ef-country"
        name="country"
        type="text"
        required
        maxlength="80"
        autocomplete="country-name"
        placeholder="Netherlands"
        class="c27-field h-12"
      />
    </div>
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-hires" class="text-caption font-semibold">
        Positions <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <Select id="ef-hires" name="hires" required>
        {HIRE_COUNTS.map((n) => <option selected={n === "2–5"}>{n}</option>)}
      </Select>
    </div>
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-start" class="text-caption font-semibold">
        Target start <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <Select id="ef-start" name="startWindow" required>
        {START_WINDOWS.map((w) => <option>{w}</option>)}
      </Select>
    </div>
  </div>

  <div class="c27-form-row grid sm:grid-cols-2">
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-engagement" class="text-caption font-semibold">
        Engagement <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <Select id="ef-engagement" name="engagement" required>
        {ENGAGEMENTS.map((e) => <option>{e}</option>)}
      </Select>
    </div>
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-arrangement" class="text-caption font-semibold">
        Work arrangement <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <Select id="ef-arrangement" name="arrangement" required>
        {ARRANGEMENTS.map((a) => <option>{a}</option>)}
      </Select>
    </div>
  </div>

  <fieldset class="grid min-w-0 gap-3">
    <legend class="text-caption font-semibold">
      Role families <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
    </legend>
    <div class="c27-choice-grid grid sm:grid-cols-2">
      {
        ROLE_FAMILIES.map((family, i) => (
          <label class="c27-choice relative flex min-h-11 cursor-pointer select-none items-center justify-between px-3.5 py-2.5 text-caption has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-c27-accent">
            <input
              type="checkbox"
              name="roleFamilies"
              value={family.id}
              required={i === 0}
              class="pointer-events-none absolute opacity-0"
            />
            <span>{family.short}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="c27-form-control grid min-w-0 gap-1.5">
    <label for="ef-detail" class="text-caption font-semibold">
      The requirement <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
    </label>
    <textarea
      id="ef-detail"
      name="requirement"
      required
      minlength="20"
      maxlength="4000"
      placeholder="Levels, stack, work model, what the team is building."
      class="c27-field min-h-[6.5rem] resize-y p-3.5"></textarea>
    <p class="text-caption text-c27-ink-3">Minimum 20 characters.</p>
  </div>

  <label
    class="c27-consent grid grid-cols-[1.1rem_minmax(0,1fr)] items-start gap-2.5 text-caption text-c27-ink-2"
  >
    <input
      type="checkbox"
      name="consent"
      required
      value="yes"
      class="mt-1 accent-[var(--c27-accent)]"
    />
    <span>
      We may use these details to respond to this enquiry, as described in the <a
        href={ROUTES.privacy}
        class="text-c27-accent-d underline underline-offset-2">privacy notice</a
      >. <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
    </span>
  </label>

  {/* Honeypot — hidden from people, tempting to bots. Plan §14.1. */}
  <div
    aria-hidden="true"
    class="absolute left-[-9999px] h-0 w-0 overflow-hidden"
  >
    <label for="ef-website">Website</label>
    <input
      id="ef-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  {/* Attribution — populated client-side, never contains PII. Plan §15.3. */}
  <input type="hidden" name="landingPage" />
  <input type="hidden" name="referrer" />
  <input type="hidden" name="utmSource" />
  <input type="hidden" name="utmMedium" />
  <input type="hidden" name="utmCampaign" />
  <input type="hidden" name="utmContent" />
  <input type="hidden" name="utmTerm" />

  <Turnstile siteKey={siteKey} action="employer-lead" />

  <div class="c27-form-actions flex flex-wrap items-center gap-3">
    <Button
      type="submit"
      variant="primary"
      arrow
      id="employer-submit"
      disabled={!siteKey}>Send requirement</Button
    >
    <p
      id="employer-status"
      role="status"
      aria-live="polite"
      class="text-caption text-c27-ink-2"
    >
    </p>
  </div>
</form>

<script>
  import { attachFormHandler } from "@/lib/form-client";

  // "At least one role family" is a group rule, and HTML can only express it
  // by marking a single box required. Carry that flag on the first box while
  // the group is empty and drop it as soon as any box is ticked, so
  // checkValidity() matches the server rule (roleFamilies.length > 0).
  const roleFamilies = document.querySelectorAll<HTMLInputElement>(
    '#employer-form input[name="roleFamilies"]',
  );
  if (roleFamilies.length) {
    const first = roleFamilies[0];
    const sync = () => {
      first.required = ![...roleFamilies].some((box) => box.checked);
    };
    roleFamilies.forEach((box) => box.addEventListener("change", sync));
    sync();
  }

  attachFormHandler({
    formId: "employer-form",
    submitId: "employer-submit",
    statusId: "employer-status",
    errorsId: "form-errors",
    redirectTo: "/thank-you/employer/",
  });
</script>
