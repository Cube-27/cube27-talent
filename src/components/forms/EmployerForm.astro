---
import Button from "@/components/ui/Button.astro";
import { ROLE_FAMILIES } from "@/data/roles";
import Select from "@/components/ui/Select.astro";
import { ENDPOINTS, ROUTES, TURNSTILE_SITE_KEY } from "@/site-config";

const siteKey = TURNSTILE_SITE_KEY;
const HIRE_COUNTS = ["1", "2–5", "6–10", "11–25", "25+"];
const START_WINDOWS = [
  "As soon as possible",
  "Within 30 days",
  "1–3 months",
  "Planning ahead",
];
const ENGAGEMENTS = ["Full-time employment", "Either", "Contract"];
const ARRANGEMENTS = ["Remote", "Hybrid", "Onsite", "Relocation", "Flexible"];
---

<form
  id="employer-form"
  method="post"
  action={ENDPOINTS.employerLead}
  novalidate
  class="grid gap-5 border border-c27-line bg-c27-surface p-[clamp(1.5rem,3vw,2.5rem)]"
>
  {/* Error summary receives focus on failed validation. §6.8. */}
  <div
    id="form-errors"
    role="alert"
    hidden
    tabindex="-1"
    class="rounded-c27-sm border border-c27-danger bg-c27-danger-soft px-4 py-3 text-caption text-c27-danger"
  >
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid min-w-0 gap-1.5">
      <label for="ef-name" class="text-caption font-semibold">Name</label>
      <input
        id="ef-name"
        name="name"
        type="text"
        required
        maxlength="100"
        autocomplete="name"
        placeholder="Priya Raghavan"
        class="h-12 w-full rounded-c27-sm border border-c27-line bg-c27-surface px-3.5 py-2.5 text-body-sm transition-shadow focus:border-c27-accent focus:outline-none focus:ring-[3px] focus:ring-c27-accent/15"
      />
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="ef-email" class="text-caption font-semibold">Work email</label
      >
      <input
        id="ef-email"
        name="email"
        type="email"
        required
        maxlength="320"
        autocomplete="email"
        placeholder="you@company.com"
        class="h-12 w-full rounded-c27-sm border border-c27-line bg-c27-surface px-3.5 py-2.5 text-body-sm transition-shadow focus:border-c27-accent focus:outline-none focus:ring-[3px] focus:ring-c27-accent/15"
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid min-w-0 gap-1.5">
      <label for="ef-company" class="text-caption font-semibold">Company</label>
      <input
        id="ef-company"
        name="company"
        type="text"
        required
        maxlength="200"
        autocomplete="organization"
        placeholder="Company name"
        class="h-12 w-full rounded-c27-sm border border-c27-line bg-c27-surface px-3.5 py-2.5 text-body-sm transition-shadow focus:border-c27-accent focus:outline-none focus:ring-[3px] focus:ring-c27-accent/15"
      />
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="ef-title" class="text-caption font-semibold">Job title</label>
      <input
        id="ef-title"
        name="jobTitle"
        type="text"
        required
        maxlength="120"
        autocomplete="organization-title"
        placeholder="VP Engineering"
        class="h-12 w-full rounded-c27-sm border border-c27-line bg-c27-surface px-3.5 py-2.5 text-body-sm transition-shadow focus:border-c27-accent focus:outline-none focus:ring-[3px] focus:ring-c27-accent/15"
      />
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-3">
    <div class="grid min-w-0 gap-1.5">
      <label for="ef-country" class="text-caption font-semibold">Country</label>
      <input
        id="ef-country"
        name="country"
        type="text"
        required
        maxlength="80"
        autocomplete="country-name"
        placeholder="Netherlands"
        class="h-12 w-full rounded-c27-sm border border-c27-line bg-c27-surface px-3.5 py-2.5 text-body-sm transition-shadow focus:border-c27-accent focus:outline-none focus:ring-[3px] focus:ring-c27-accent/15"
      />
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="ef-hires" class="text-caption font-semibold">Positions</label>
      <Select id="ef-hires" name="hires" required>
        {HIRE_COUNTS.map((n) => <option selected={n === "2–5"}>{n}</option>)}
      </Select>
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="ef-start" class="text-caption font-semibold"
        >Target start</label
      >
      <Select id="ef-start" name="startWindow" required>
        {START_WINDOWS.map((w) => <option>{w}</option>)}
      </Select>
    </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div class="grid min-w-0 gap-1.5">
      <label for="ef-engagement" class="text-caption font-semibold"
        >Engagement</label
      >
      <Select id="ef-engagement" name="engagement" required>
        {ENGAGEMENTS.map((e) => <option>{e}</option>)}
      </Select>
    </div>
    <div class="grid min-w-0 gap-1.5">
      <label for="ef-arrangement" class="text-caption font-semibold"
        >Work arrangement</label
      >
      <Select id="ef-arrangement" name="arrangement" required>
        {ARRANGEMENTS.map((a) => <option>{a}</option>)}
      </Select>
    </div>
  </div>

  <fieldset class="grid min-w-0 gap-1.5">
    <legend class="mb-1 text-caption font-semibold">Role families</legend>
    <div class="flex flex-wrap gap-2">
      {
        ROLE_FAMILIES.map((family, i) => (
          <label class="relative cursor-pointer select-none rounded-c27-sm border border-c27-line bg-c27-surface px-3.5 py-2 text-caption transition-colors has-[:checked]:border-c27-accent has-[:checked]:bg-c27-accent-soft has-[:checked]:font-semibold has-[:checked]:text-c27-accent-d has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-c27-accent">
            <input
              type="checkbox"
              name="roleFamilies"
              value={family.id}
              required={i === 0}
              class="pointer-events-none absolute opacity-0"
            />
            {family.short}
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="grid min-w-0 gap-1.5">
    <label for="ef-detail" class="text-caption font-semibold"
      >The requirement</label
    >
    <textarea
      id="ef-detail"
      name="requirement"
      required
      minlength="20"
      maxlength="4000"
      placeholder="Levels, stack, work model, what the team is building."
      class="min-h-[6rem] w-full resize-y rounded-c27-sm border border-c27-line bg-c27-surface px-3.5 py-2.5 text-body-sm transition-shadow focus:border-c27-accent focus:outline-none focus:ring-[3px] focus:ring-c27-accent/15"
    ></textarea>
  </div>

  <label
    class="grid grid-cols-[1.1rem_minmax(0,1fr)] items-start gap-2.5 text-caption text-c27-ink-2"
  >
    <input
      type="checkbox"
      name="consent"
      required
      value="yes"
      class="mt-1 accent-[var(--c27-accent)]"
    />
    <span>
      We may use these details to respond to this enquiry, as described in the <a
        href={ROUTES.privacy}
        class="text-c27-accent-d underline underline-offset-2">privacy notice</a
      >.
    </span>
  </label>

  {/* Honeypot — hidden from people, tempting to bots. Plan §14.1. */}
  <div
    aria-hidden="true"
    class="absolute left-[-9999px] h-0 w-0 overflow-hidden"
  >
    <label for="ef-website">Website</label>
    <input
      id="ef-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  {/* Attribution — populated client-side, never contains PII. Plan §15.3. */}
  <input type="hidden" name="landingPage" />
  <input type="hidden" name="referrer" />
  <input type="hidden" name="utmSource" />
  <input type="hidden" name="utmMedium" />
  <input type="hidden" name="utmCampaign" />
  <input type="hidden" name="utmContent" />
  <input type="hidden" name="utmTerm" />

  {
    siteKey && (
      <div
        class="cf-turnstile"
        data-sitekey={siteKey}
        data-theme="light"
        data-action="employer-lead"
      />
    )
  }

  <div class="flex flex-wrap items-center gap-3">
    <Button
      type="submit"
      variant="primary"
      arrow
      id="employer-submit"
      disabled={!siteKey}>Send requirement</Button
    >
    <p
      id="employer-status"
      role="status"
      aria-live="polite"
      class="text-caption text-c27-ink-2"
    >
    </p>
  </div>
</form>

{
  siteKey && (
    <script
      is:inline
      async
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    />
  )
}

<script>
  import { attachFormHandler } from "@/lib/form-client";

  // "At least one role family" is a group rule, and HTML can only express it
  // by marking a single box required. Carry that flag on the first box while
  // the group is empty and drop it as soon as any box is ticked, so
  // checkValidity() matches the server rule (roleFamilies.length > 0).
  const roleFamilies = document.querySelectorAll<HTMLInputElement>(
    '#employer-form input[name="roleFamilies"]',
  );
  if (roleFamilies.length) {
    const first = roleFamilies[0];
    const sync = () => {
      first.required = ![...roleFamilies].some((box) => box.checked);
    };
    roleFamilies.forEach((box) => box.addEventListener("change", sync));
    sync();
  }

  attachFormHandler({
    formId: "employer-form",
    submitId: "employer-submit",
    statusId: "employer-status",
    errorsId: "form-errors",
    redirectTo: "/thank-you/employer/",
  });
</script>
