---
import Button from "@/components/ui/Button.astro";
import Turnstile from "@/components/ui/Turnstile.astro";
import { ENDPOINTS, ROUTES, TURNSTILE_SITE_KEY } from "@/site-config";

const siteKey = TURNSTILE_SITE_KEY;
---

<form
  id="employer-form"
  method="post"
  action={ENDPOINTS.employerLead}
  novalidate
  class="c27-form-shell grid gap-5"
>
  <noscript>
    <p
      class="border border-c27-line bg-c27-surface-2 px-4 py-3 text-caption leading-relaxed text-c27-ink-2"
    >
      Submitting this form needs JavaScript. With it turned off, email
      <a
        href="mailto:talent@cube27.com"
        class="text-c27-accent-d underline underline-offset-2"
        >talent@cube27.com</a
      > with your name, company, work email, and anything useful about your hiring
      needs.
    </p>
  </noscript>

  <div
    id="form-errors"
    role="alert"
    hidden
    tabindex="-1"
    class="border border-c27-danger bg-c27-danger-soft px-4 py-3 text-caption text-c27-danger"
  >
  </div>

  <p class="text-caption text-c27-ink-3">
    <span class="text-c27-accent font-bold" aria-hidden="true">*</span> Required fields
  </p>

  <div class="c27-form-row grid sm:grid-cols-2">
    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-name" class="text-caption font-semibold">
        Name <span class="text-c27-accent font-bold" aria-hidden="true">*</span>
      </label>
      <input
        id="ef-name"
        name="name"
        type="text"
        required
        maxlength="100"
        autocomplete="name"
        placeholder="Priya Raghavan"
        class="c27-field h-12"
      />
    </div>

    <div class="c27-form-control grid min-w-0 gap-1.5">
      <label for="ef-company" class="text-caption font-semibold">
        Company <span class="text-c27-accent font-bold" aria-hidden="true"
          >*</span
        >
      </label>
      <input
        id="ef-company"
        name="company"
        type="text"
        required
        maxlength="200"
        autocomplete="organization"
        placeholder="Company name"
        class="c27-field h-12"
      />
    </div>
  </div>

  <div class="c27-form-control grid min-w-0 gap-1.5">
    <label for="ef-email" class="text-caption font-semibold">
      Work email <span class="text-c27-accent font-bold" aria-hidden="true"
        >*</span
      >
    </label>
    <input
      id="ef-email"
      name="email"
      type="email"
      required
      maxlength="320"
      autocomplete="email"
      inputmode="email"
      placeholder="you@company.com"
      class="c27-field h-12"
    />
  </div>

  <div class="c27-form-control grid min-w-0 gap-1.5">
    <label
      for="ef-detail"
      class="flex items-baseline justify-between gap-3 text-caption font-semibold"
    >
      <span>What do you need?</span>
      <span class="font-normal text-c27-ink-3">Optional</span>
    </label>
    <textarea
      id="ef-detail"
      name="requirement"
      maxlength="4000"
      placeholder="A role, a complete team, or an early-stage hiring plan."
      class="c27-field min-h-[7rem] resize-y p-3.5"></textarea>
  </div>

  <p class="text-caption leading-relaxed text-c27-ink-2">
    We use these details only to respond to your enquiry. See our{" "}
    <a
      href={ROUTES.privacy}
      class="text-c27-accent-d underline underline-offset-2">privacy notice</a
    >.
  </p>

  <div
    aria-hidden="true"
    class="absolute left-[-9999px] h-0 w-0 overflow-hidden"
  >
    <label for="ef-website">Website</label>
    <input
      id="ef-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <input type="hidden" name="landingPage" />
  <input type="hidden" name="referrer" />
  <input type="hidden" name="utmSource" />
  <input type="hidden" name="utmMedium" />
  <input type="hidden" name="utmCampaign" />
  <input type="hidden" name="utmContent" />
  <input type="hidden" name="utmTerm" />

  <Turnstile siteKey={siteKey} action="employer-lead" />

  <div class="c27-form-actions flex flex-wrap items-center gap-3">
    <Button
      type="submit"
      variant="primary"
      arrow
      id="employer-submit"
      disabled={!siteKey}>Send enquiry</Button
    >
    <p
      id="employer-status"
      role="status"
      aria-live="polite"
      class="text-caption text-c27-ink-2"
    >
    </p>
  </div>
</form>

<script>
  import { attachFormHandler } from "@/lib/form-client";

  attachFormHandler({
    formId: "employer-form",
    submitId: "employer-submit",
    statusId: "employer-status",
    errorsId: "form-errors",
    redirectTo: "/thank-you/employer/",
  });
</script>
