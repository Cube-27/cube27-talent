---
import { SITE_CONFIG, ROUTES } from "@/site-config";

const year = new Date().getFullYear();
---

<footer class="bg-c27-navy py-12 text-body-sm text-c27-on-navy-2">
  <div class="c27-wrap">
    <div class="grid gap-8 md:grid-cols-[1.7fr_1fr_1fr_1fr]">
      <div>
        <img
          src="/cube27-logo.png"
          alt="Cube27"
          width="457"
          height="161"
          class="h-8 w-auto rounded-md bg-white px-2 py-1.5"
        />
        <p class="mt-3.5 max-w-[32ch]">
          Managed engineering talent and staffing. A vertical of {
            SITE_CONFIG.organization.legalName
          }, {SITE_CONFIG.organization.address.addressLocality}.
        </p>
      </div>

      <div>
        <h4 class="mb-2.5 font-display text-caption font-bold text-white">
          Companies
        </h4>
        <ul>
          <li class="py-0.5">
            <a href={ROUTES.expertise} class="no-underline hover:text-white"
              >Expertise</a
            >
          </li>
          <li class="py-0.5">
            <a href={ROUTES.how} class="no-underline hover:text-white"
              >How it works</a
            >
          </li>
          <li class="py-0.5">
            <a href={ROUTES.hire} class="no-underline hover:text-white"
              >Hire talent</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="mb-2.5 font-display text-caption font-bold text-white">
          Engineers
        </h4>
        <ul>
          <li class="py-0.5">
            <a href={ROUTES.join} class="no-underline hover:text-white"
              >Find a job</a
            >
          </li>
          <li class="py-0.5">
            <a href={ROUTES.how} class="no-underline hover:text-white"
              >Screening process</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="mb-2.5 font-display text-caption font-bold text-white">
          Company
        </h4>
        <ul>
          <li class="py-0.5">
            <a
              href={SITE_CONFIG.organization.parentSite}
              class="no-underline hover:text-white">cube27.com</a
            >
          </li>
          <li class="py-0.5">
            <a href={ROUTES.privacy} class="no-underline hover:text-white"
              >Privacy</a
            >
          </li>
          <li class="py-0.5">
            <a href={ROUTES.terms} class="no-underline hover:text-white"
              >Terms</a
            >
          </li>
          <li class="py-0.5">
            <a
              href={`mailto:${SITE_CONFIG.organization.email}`}
              class="no-underline hover:text-white"
              >{SITE_CONFIG.organization.email}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <p
      class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-c27-line-dark pt-5 text-caption text-c27-on-navy-3"
    >
      <span>&copy; {year} {SITE_CONFIG.organization.legalName}</span>
      <span>talent.cube27.com</span>
    </p>
  </div>
</footer>
