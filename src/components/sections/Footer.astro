---
import { SITE_CONFIG, ROUTES } from "@/site-config";

const year = new Date().getFullYear();
---

<footer
  class="site-footer border-t border-c27-line-deep bg-c27-deep text-body-sm text-c27-on-deep-2"
>
  <div class="c27-wrap py-12">
    <div class="grid gap-10 md:grid-cols-[minmax(0,1.4fr)_1fr_1fr]">
      <div>
        <a
          href={ROUTES.home}
          aria-label="Cube27 Talent"
          class="inline-flex items-center gap-3 no-underline"
        >
          <img
            src="/cube27-mark.svg"
            alt=""
            width="48"
            height="48"
            class="size-9"
          />
          <span
            class="font-display text-lg font-semibold tracking-[0.04em] text-c27-on-deep"
            >CUBE<span class="text-c27-brand-27">27</span> | Talent</span
          >
        </a>
        <p class="mt-4 max-w-[42ch] leading-relaxed">
          Managed talent and team building for global organizations.
        </p>
      </div>

      <div>
        <h2
          class="mb-3 font-display text-body-sm font-semibold text-c27-on-deep"
        >
          Work with us
        </h2>
        <ul class="grid gap-2">
          <li>
            <a
              href={ROUTES.hire}
              class="no-underline hover:text-c27-on-deep-accent"
              >Build your team</a
            >
          </li>
          <li>
            <a
              href={ROUTES.how}
              class="no-underline hover:text-c27-on-deep-accent">How we hire</a
            >
          </li>
          <li>
            <a
              href={ROUTES.whyUs}
              class="no-underline hover:text-c27-on-deep-accent">Why us</a
            >
          </li>
          <li>
            <a
              href={ROUTES.join}
              class="no-underline hover:text-c27-on-deep-accent">For talent</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h2
          class="mb-3 font-display text-body-sm font-semibold text-c27-on-deep"
        >
          Company
        </h2>
        <ul class="grid gap-2">
          <li>
            <a
              href={SITE_CONFIG.organization.parentSite}
              class="no-underline hover:text-c27-on-deep-accent">cube27.com</a
            >
          </li>
          <li>
            <a
              href={ROUTES.privacy}
              class="no-underline hover:text-c27-on-deep-accent">Privacy</a
            >
          </li>
          <li>
            <a
              href={ROUTES.terms}
              class="no-underline hover:text-c27-on-deep-accent">Terms</a
            >
          </li>
          <li>
            <a
              href={`mailto:${SITE_CONFIG.organization.email}`}
              class="no-underline hover:text-c27-on-deep-accent"
              >{SITE_CONFIG.organization.email}</a
            >
          </li>
        </ul>
      </div>
    </div>

    <p
      class="mt-10 flex flex-wrap gap-x-6 gap-y-2 border-t border-c27-line-deep pt-5 text-caption text-c27-on-deep-3"
    >
      <span>&copy; {year} {SITE_CONFIG.organization.legalName}</span>
      <span
        >{SITE_CONFIG.organization.address.addressLocality}, {
          SITE_CONFIG.organization.address.addressCountry
        }</span
      >
    </p>
  </div>
</footer>
