---
import { PROCESS_STEPS } from "@/data/process";

/**
 * Nine-step process. Design system §6.7. Opens on step 05 — the technical
 * interview is the differentiator, so it is the default panel.
 */
const DEFAULT_INDEX = 4;
---

<div
  class="grid gap-[clamp(2rem,4vw,3rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-start"
  data-process
>
  <div class="c27-rise grid gap-1.5" role="tablist" aria-label="Process steps">
    {
      PROCESS_STEPS.map((step, i) => (
        <button
          type="button"
          role="tab"
          id={`step-tab-${step.n}`}
          aria-controls={`step-panel-${step.n}`}
          aria-selected={i === DEFAULT_INDEX ? "true" : "false"}
          tabindex={i === DEFAULT_INDEX ? 0 : -1}
          class="grid min-h-11 w-full grid-cols-[2.25rem_minmax(0,1fr)_auto] items-center gap-3.5 rounded-c27 border border-transparent bg-white/[0.06] px-3.5 py-2.5 text-left text-body-sm text-c27-on-navy-2 transition-colors hover:bg-white/10 hover:text-white aria-selected:border-white aria-selected:bg-white aria-selected:font-semibold aria-selected:text-c27-ink"
        >
          <span class="font-display text-caption font-bold tabular-nums text-c27-on-navy-accent [button[aria-selected='true']_&]:text-c27-blue">
            {step.n}
          </span>
          <span>{step.name}</span>
          <span class="text-micro uppercase tracking-[0.1em] text-c27-on-navy-3 [button[aria-selected='true']_&]:text-c27-ink-3">
            {step.owner}
          </span>
        </button>
      ))
    }
  </div>

  <div
    class="c27-rise rounded-c27-lg border border-c27-line-dark bg-white/[0.07] p-[clamp(1.5rem,3vw,2.25rem)]"
    style="--c27-d:100ms"
  >
    {
      PROCESS_STEPS.map((step, i) => (
        <div
          role="tabpanel"
          id={`step-panel-${step.n}`}
          aria-labelledby={`step-tab-${step.n}`}
          hidden={i !== DEFAULT_INDEX}
          data-step-panel
        >
          <span class="c27-label mb-2.5 block text-c27-on-navy-accent">
            Step {step.n} &middot; {step.owner}
          </span>
          <h3 class="c27-h3-lg text-white">{step.name}</h3>
          <p class="mt-3 max-w-[46ch] text-body-sm text-c27-on-navy-2">
            {step.detail}
          </p>
          <ul class="mt-5 grid gap-2">
            {step.points.map((point) => (
              <li class="grid grid-cols-[1.15rem_minmax(0,1fr)] gap-2 text-caption text-c27-on-navy-2">
                <span class="text-c27-green" aria-hidden="true">
                  &#10003;
                </span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-process]")) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-step-panel]")];

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        const delta =
          event.key === "ArrowDown" || event.key === "ArrowRight"
            ? 1
            : event.key === "ArrowUp" || event.key === "ArrowLeft"
              ? -1
              : 0;
        if (!delta) return;
        event.preventDefault();
        select((i + delta + tabs.length) % tabs.length, true);
      });
    });
  }
</script>
