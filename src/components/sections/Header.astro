---
import Button from "@/components/ui/Button.astro";
import { NAV_LINKS, ROUTES } from "@/site-config";

interface Props {
  bare?: boolean;
}

const { bare = false } = Astro.props;
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href);
---

<header
  id="site-header"
  class="sticky top-0 z-30 border-b border-c27-line bg-c27-surface"
>
  <div class="c27-wrap flex min-h-[4.5rem] items-center gap-5 lg:gap-8">
    <a
      href={ROUTES.home}
      class="mr-auto flex items-center gap-2 font-display text-base font-semibold tracking-tight text-c27-ink no-underline sm:text-lg"
      aria-label="Cube27 Talent"
    >
      <img
        src="/cube27_logo.webp"
        alt="Cube27"
        width="300"
        height="109"
        class="h-10 w-auto sm:h-11"
      />
      <span class="hidden sm:inline">| Talent</span>
    </a>

    {
      !bare && (
        <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
          {NAV_LINKS.map((link) => (
            <a
              href={link.href}
              aria-current={isActive(link.href) ? "page" : undefined}
              class:list={[
                "text-body-sm font-medium no-underline transition-colors hover:text-c27-accent",
                isActive(link.href) ? "text-c27-accent" : "text-c27-ink-2",
              ]}
            >
              {link.label}
            </a>
          ))}
        </nav>
      )
    }

    {
      !bare && (
        <Button href={ROUTES.hire} size="header">
          Build your team
        </Button>
      )
    }

    {
      !bare && (
        <details id="mobile-menu" class="lg:hidden">
          <summary
            class="grid size-11 cursor-pointer place-items-center text-c27-ink transition-colors hover:bg-c27-surface-2"
            aria-label="Menu"
          >
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class="menu-open"
            >
              <path
                d="M4 7h16M4 12h16M4 17h16"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="square"
              />
            </svg>
            <svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              aria-hidden="true"
              class="menu-close"
            >
              <path
                d="M6 6l12 12M18 6L6 18"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="square"
              />
            </svg>
          </summary>

          <div class="absolute inset-x-0 top-full border-y border-c27-line bg-c27-surface shadow-c27-overlay">
            <nav class="c27-wrap py-3" aria-label="Menu">
              <ul>
                {NAV_LINKS.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      aria-current={isActive(link.href) ? "page" : undefined}
                      class:list={[
                        "flex min-h-12 items-center border-b border-c27-line-2 text-body-sm font-medium no-underline",
                        isActive(link.href)
                          ? "text-c27-accent"
                          : "text-c27-ink",
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </div>
        </details>
      )
    }
  </div>
</header>

<style>
  #mobile-menu > summary {
    list-style: none;
  }

  #mobile-menu > summary::-webkit-details-marker {
    display: none;
  }

  #mobile-menu > summary > svg {
    grid-area: 1 / 1;
  }

  #mobile-menu:not([open]) .menu-close,
  #mobile-menu[open] .menu-open {
    display: none;
  }
</style>

<script>
  const menu = document.getElementById(
    "mobile-menu",
  ) as HTMLDetailsElement | null;
  if (menu) {
    const close = () => menu.removeAttribute("open");
    menu
      .querySelectorAll("a")
      .forEach((link) => link.addEventListener("click", close));
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && menu.open) {
        close();
        menu.querySelector("summary")?.focus();
      }
    });
    document.addEventListener("click", (event) => {
      if (menu.open && !menu.contains(event.target as Node)) close();
    });
  }
</script>
