---
import Icon from "@/components/ui/Icon.astro";
import { LIFECYCLE } from "@/data/process";
---

<div class="c27-rule-grid" style="--c27-cols:4">
  {
    LIFECYCLE.map((item, index) => (
      <article class="c27-rise" style={`--c27-d:${index * 60}ms`}>
        <Icon name={item.icon} size={24} class="text-c27-accent" />
        <h3 class="c27-card-title mt-4 font-semibold text-c27-ink">
          {item.title}
        </h3>
        <p class="mt-2 max-w-[34ch] text-body-sm leading-relaxed text-c27-ink-2">
          {item.body}
        </p>
      </article>
    ))
  }
</div>
