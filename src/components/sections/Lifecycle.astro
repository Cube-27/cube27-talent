---
import Icon from "@/components/ui/Icon.astro";
import { LIFECYCLE } from "@/data/process";

const ICON_STYLES = {
  violet: "text-c27-icon-violet c27-tile-violet",
  mint: "text-c27-icon-green c27-tile-mint",
  peach: "text-c27-icon-orange c27-tile-peach",
  sky: "text-c27-icon-blue c27-tile-sky",
} as const;
---

<div
  class="c27-card-shadow c27-gradient-blue grid border border-c27-line lg:grid-cols-4"
>
  {
    LIFECYCLE.map((item, index) => (
      <article
        class:list={[
          "c27-rise grid content-start gap-4 bg-transparent p-6",
          index > 0 &&
            "border-t border-c27-line-deep lg:border-l lg:border-t-0",
        ]}
        style={`--c27-d:${index * 60}ms`}
      >
        <span
          class:list={[
            "grid size-11 place-items-center",
            ICON_STYLES[item.tint],
          ]}
        >
          <Icon name={item.icon} size={19} />
        </span>
        <div>
          <h3 class="c27-h3 font-semibold text-c27-ink">{item.title}</h3>
          <p class="mt-2 text-body-sm leading-relaxed text-c27-ink-2">
            {item.body}
          </p>
        </div>
      </article>
    ))
  }
</div>
