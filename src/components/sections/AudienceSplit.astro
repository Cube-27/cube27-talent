---
import Button from "@/components/ui/Button.astro";
import { ROUTES } from "@/site-config";

/**
 * Both funnels, side by side. Design system §1.5 — the candidate path is never
 * demoted to a footer link, even though employer acquisition is the commercial
 * priority (invariant 2).
 */
const companyPoints = [
  "One senior hire or a whole delivery team",
  "Screened and interviewed before the client meets anyone",
  "Employment, payroll and hardware handled by Cube27",
  "Remote, hybrid, onsite or relocation",
];

const engineerPoints = [
  "A Cube27 employee on a stable payroll, not a contractor between gigs",
  "Work hardware provided",
  "Assignments with global clients",
  "Overseas assignments where they arise, with visa process assistance",
];
---

<div class="grid gap-5 md:grid-cols-2">
  <div
    class="c27-rise grid content-start gap-3.5 rounded-c27-lg border border-c27-line bg-c27-surface p-[clamp(1.75rem,3.5vw,2.75rem)]"
  >
    <span class="c27-label">For companies</span>
    <h3 class="c27-h3-lg">Build a team</h3>
    <ul class="my-1 grid gap-2">
      {
        companyPoints.map((point) => (
          <li class="grid grid-cols-[1.15rem_minmax(0,1fr)] gap-2 text-body-sm text-c27-ink-2">
            <span class="text-c27-green-d" aria-hidden="true">
              &#10003;
            </span>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
    <div class="mt-1.5">
      <Button href={ROUTES.hire} variant="primary" arrow>Hire talent</Button>
    </div>
  </div>

  <div
    class="c27-rise grid content-start gap-3.5 rounded-c27-lg border border-transparent bg-[linear-gradient(160deg,var(--c27-tint)_0%,var(--c27-tint-2)_100%)] p-[clamp(1.75rem,3.5vw,2.75rem)]"
    style="--c27-d:90ms"
  >
    <span class="c27-label">For engineers</span>
    <h3 class="c27-h3-lg">Join Cube27</h3>
    <ul class="my-1 grid gap-2">
      {
        engineerPoints.map((point) => (
          <li class="grid grid-cols-[1.15rem_minmax(0,1fr)] gap-2 text-body-sm text-c27-ink-2">
            <span class="text-c27-blue" aria-hidden="true">
              &#10003;
            </span>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
    <div class="mt-1.5">
      <Button href={ROUTES.join} variant="blue" arrow>Find a job</Button>
    </div>
    {
      /* Invariants 22-23, 32: no guaranteed placement, travel or visa. This
         disclaimer ships with every candidate CTA. */
    }
    <p class="text-caption text-c27-ink-3">
      Applying does not guarantee screening, an interview, employment or an
      assignment. Overseas travel and visa approval are never guaranteed.
    </p>
  </div>
</div>
