---
import Button from "@/components/ui/Button.astro";
import { ROUTES } from "@/site-config";

/**
 * Both funnels, side by side. The candidate path is never demoted to a footer
 * link, even though employer acquisition is the commercial priority
 * (invariant 2).
 *
 * Copy rules: no company name (rule 0.1), and nothing contractual (rule 0.2) —
 * which is why neither list mentions equipment or who the employer is.
 */
const companyPoints = [
  "One senior specialist, or a team built out over a year",
  "Assessed and interviewed before you meet anyone",
  "Hiring, onboarding, payroll and admin handled",
  "Remote, hybrid, onsite or relocation",
];

const candidatePoints = [
  "Real employment with global clients, not gig work",
  "An assessment matched to what you actually do",
  "A process that tells you where you stand",
  "Room to grow, and work that keeps coming",
];
---

<div class="grid gap-5 md:grid-cols-2">
  <div
    class="c27-rise grid content-start gap-4 rounded-c27-lg bg-c27-surface-2 p-[clamp(1.75rem,3.5vw,2.75rem)]"
  >
    <span class="c27-label">For companies</span>
    <h3 class="c27-h3-lg font-bold text-c27-ink">Build a team</h3>
    <ul class="my-1 grid gap-2.5">
      {
        companyPoints.map((point) => (
          <li class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-2.5 text-body-sm leading-snug text-c27-ink-2">
            <span class="font-bold text-c27-accent" aria-hidden="true">
              &#10003;
            </span>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
    <div class="mt-2">
      <Button href={ROUTES.hire} variant="primary" arrow>Hire talent</Button>
    </div>
  </div>

  <div
    class="c27-rise grid content-start gap-4 rounded-c27-lg bg-c27-tint-violet p-[clamp(1.75rem,3.5vw,2.75rem)]"
    style="--c27-d:90ms"
  >
    <span class="c27-label text-c27-accent-d">For candidates</span>
    <h3 class="c27-h3-lg font-bold text-c27-ink">Find your next role</h3>
    <ul class="my-1 grid gap-2.5">
      {
        candidatePoints.map((point) => (
          <li class="grid grid-cols-[1.25rem_minmax(0,1fr)] gap-2.5 text-body-sm leading-snug text-c27-ink-2">
            <span class="font-bold text-c27-accent-d" aria-hidden="true">
              &#10003;
            </span>
            <span>{point}</span>
          </li>
        ))
      }
    </ul>
    <div class="mt-2">
      <Button href={ROUTES.join} variant="primary" arrow>Find a role</Button>
    </div>
    {
      /* Invariants 16 and 18: no guaranteed placement, travel or visa.

         The rule is that this ships with every point where someone APPLIES or
         is told an outcome — this card, the application form, the candidate
         FAQ and the confirmation page. Not with every link that happens to
         point at the careers page: a disclaimer bolted to the header nav
         button and the hero CTA would be noise, and the destination carries
         it prominently anyway.

         ink-2, not ink-3: ink-3 is 4.55:1 on this tint, which passes, but this
         is the one sentence on the card a visitor is relied upon to read. */
    }
    <p class="text-caption leading-relaxed text-c27-ink-2">
      Applying does not guarantee screening, an interview, employment or an
      assignment. Overseas travel and visa approval are never guaranteed.
    </p>
  </div>
</div>
