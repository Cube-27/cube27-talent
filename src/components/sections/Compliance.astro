---
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";

interface Props {
  index?: string;
}

const { index } = Astro.props;

const COMPLIANCE_AREAS = [
  {
    title: "Contracts and local requirements",
    body: "Coordinate contract execution and applicable local labor and IP requirements.",
    icon: "doc" as const,
  },
  {
    title: "Payroll and administration",
    body: "Keep recurring payroll and workforce administration consistent.",
    icon: "briefcase" as const,
  },
  {
    title: "Culture onboarding",
    body: "Our HR specialists translate each client's culture, expectations, and ways of working into onboarding and ongoing support.",
    icon: "users" as const,
  },
  {
    title: "Performance standards",
    body: "Facilitate reviews against criteria defined with the client.",
    icon: "chart" as const,
  },
];
---

<div>
  <SectionHead
    index={index}
    label="Operating standard"
    heading="Standards that scale with your team"
    lede="We coordinate the standards behind every hire—from contracts and payroll to local labor and IP requirements, culture onboarding, and client-defined performance reviews."
  />

  <div class="c27-rule-grid" style="--c27-cols:4">
    {
      COMPLIANCE_AREAS.map((area, i) => (
        <article class="c27-rise" style={`--c27-d:${i * 60}ms`}>
          <Icon name={area.icon} size={24} class="text-c27-accent" />
          <h3 class="c27-card-title mt-4 font-semibold text-c27-ink">
            {area.title}
          </h3>
          <p class="mt-2 max-w-[34ch] text-body-sm leading-relaxed text-c27-ink-2">
            {area.body}
          </p>
        </article>
      ))
    }
  </div>
</div>
