---
import Icon from "@/components/ui/Icon.astro";

const COMPLIANCE_AREAS = [
  {
    title: "Contracts and local requirements",
    body: "Coordinate contract execution and applicable local labor and IP requirements.",
    icon: "doc" as const,
  },
  {
    title: "Payroll and administration",
    body: "Keep recurring payroll and workforce administration consistent.",
    icon: "briefcase" as const,
  },
  {
    title: "Culture onboarding",
    body: "Our HR specialists translate each client's culture, expectations, and ways of working into onboarding and ongoing support.",
    icon: "users" as const,
  },
  {
    title: "Performance standards",
    body: "Facilitate reviews against criteria defined with the client.",
    icon: "chart" as const,
  },
];
---

<div class="c27-rise">
  <div
    class="grid gap-8 border-b border-c27-line pb-[clamp(2rem,4vw,3rem)] lg:grid-cols-[minmax(0,0.85fr)_minmax(28rem,1.15fr)] lg:items-end"
  >
    <h2 class="c27-h2 max-w-[18ch]">Standards that scale with your team</h2>
    <p class="c27-lede">
      We coordinate the standards behind every hire—from contracts and payroll
      to local labor and IP requirements, culture onboarding, and client-defined
      performance reviews.
    </p>
  </div>

  <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      COMPLIANCE_AREAS.map((area, index) => (
        <article
          class="c27-card-shadow c27-rise flex flex-col justify-start border border-c27-line bg-c27-surface p-5 sm:p-6"
          style={`--c27-d:${index * 60}ms`}
        >
          <span
            class="c27-tile-accent grid size-10 place-items-center border border-c27-accent/15 text-c27-accent"
            aria-hidden="true"
          >
            <Icon name={area.icon} size={20} />
          </span>
          <div class="mt-4">
            <h3 class="c27-card-title font-semibold text-c27-ink">
              {area.title}
            </h3>
            <p class="mt-2 text-body-sm leading-relaxed text-c27-ink-2">
              {area.body}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</div>
