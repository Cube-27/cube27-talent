---
import Icon from "@/components/ui/Icon.astro";

const COMPLIANCE_AREAS = [
  {
    title: "Contracts and local requirements",
    body: "Coordinate contract execution and applicable local labor and IP requirements.",
    icon: "doc" as const,
    color: "text-c27-icon-violet",
    tile: "c27-tile-violet",
  },
  {
    title: "Payroll and administration",
    body: "Keep recurring payroll and workforce administration consistent.",
    icon: "briefcase" as const,
    color: "text-c27-icon-blue",
    tile: "c27-tile-sky",
  },
  {
    title: "Culture onboarding",
    body: "Our HR specialists translate each client's culture, expectations, and ways of working into onboarding and ongoing support.",
    icon: "users" as const,
    color: "text-c27-icon-orange",
    tile: "c27-tile-peach",
  },
  {
    title: "Performance standards",
    body: "Facilitate reviews against criteria defined with the client.",
    icon: "chart" as const,
    color: "text-c27-icon-green",
    tile: "c27-tile-mint",
  },
];
---

<div class="c27-rise">
  <div
    class="grid gap-8 border-b border-c27-line pb-[clamp(2.5rem,5vw,4rem)] lg:grid-cols-[minmax(0,0.85fr)_minmax(28rem,1.15fr)] lg:items-end"
  >
    <h2 class="c27-h2 max-w-[18ch]">Standards that scale with your team</h2>
    <p
      class="max-w-[66ch] text-[clamp(1rem,1.4vw,1.125rem)] leading-relaxed text-c27-ink-2"
    >
      We coordinate the standards behind every hire—from contracts and payroll
      to local labor and IP requirements, culture onboarding, and client-defined
      performance reviews.
    </p>
  </div>

  <div class="grid border-x border-b border-c27-line md:grid-cols-2">
    {
      COMPLIANCE_AREAS.map((area, index) => (
        <article
          class:list={[
            "grid content-start gap-5 bg-c27-surface p-[clamp(1.5rem,3vw,2.5rem)] md:min-h-52",
            index > 0 && "border-t border-c27-line",
            index === 1 && "md:border-l md:border-t-0",
            index === 2 && "md:border-t",
            index === 3 && "md:border-l",
          ]}
        >
          <span
            class:list={[
              "grid size-11 place-items-center",
              area.color,
              area.tile,
            ]}
            aria-hidden="true"
          >
            <Icon name={area.icon} size={22} />
          </span>
          <div>
            <h3 class="c27-h3-lg font-semibold text-c27-ink">{area.title}</h3>
            <p class="mt-3 max-w-[52ch] text-body-sm leading-relaxed text-c27-ink-2">
              {area.body}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</div>
