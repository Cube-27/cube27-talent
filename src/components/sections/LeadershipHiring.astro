---
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import { ROUTES } from "@/site-config";

const LEADERSHIP_AREAS = [
  {
    title: "Technology leadership",
    roles: "CTO · CIO",
    icon: "cloud" as const,
  },
  {
    title: "Business and operations",
    roles: "COO · Functional heads",
    icon: "briefcase" as const,
  },
  {
    title: "Product and engineering",
    roles: "VP Engineering · Head of Product",
    icon: "board" as const,
  },
  {
    title: "Data and AI leadership",
    roles: "Head of Data · VP Data and AI",
    icon: "chart" as const,
  },
];
---

<div
  class="c27-card-shadow c27-rise border border-c27-line bg-c27-surface-2 px-[clamp(1.5rem,4vw,3.5rem)] py-[clamp(2.5rem,5vw,4rem)]"
>
  <div class="flex flex-col items-center gap-6 text-center">
    <h2 class="c27-h2 max-w-none text-c27-ink">
      Hire leaders who can build the function
    </h2>
    <div>
      <p class="c27-lede mx-auto">
        Executive search for leaders who can set direction, build teams, and own
        the outcome.
      </p>
      <div class="mt-6">
        <Button href={ROUTES.hire} variant="primary" arrow
          >Start a leadership search</Button
        >
      </div>
    </div>
  </div>

  <ul
    class="mt-[clamp(2rem,4vw,3.5rem)] grid gap-4 md:grid-cols-2 lg:grid-cols-4"
  >
    {
      LEADERSHIP_AREAS.map((area) => (
        <li class="c27-card-shadow flex flex-col justify-between border border-c27-line bg-c27-surface p-5 sm:p-6">
          <span
            class="c27-tile-accent grid size-10 place-items-center border border-c27-accent/15 text-c27-accent"
            aria-hidden="true"
          >
            <Icon name={area.icon} size={20} />
          </span>
          <div class="mt-4">
            <h3 class="c27-card-title font-semibold text-c27-ink">
              {area.title}
            </h3>
            <p class="mt-1 text-body-sm leading-relaxed text-c27-ink-2">
              {area.roles}
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</div>
