---
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import { ROUTES } from "@/site-config";

const LEADERSHIP_AREAS = [
  {
    title: "Technology leadership",
    roles: "CTO · CIO",
    icon: "cloud" as const,
    color: "text-c27-icon-blue",
    tile: "c27-tile-sky",
  },
  {
    title: "Business and operations",
    roles: "COO · Functional heads",
    icon: "briefcase" as const,
    color: "text-c27-icon-violet",
    tile: "c27-tile-violet",
  },
  {
    title: "Product and engineering",
    roles: "VP Engineering · Head of Product",
    icon: "board" as const,
    color: "text-c27-icon-orange",
    tile: "c27-tile-peach",
  },
  {
    title: "Data and AI leadership",
    roles: "Head of Data · VP Data and AI",
    icon: "chart" as const,
    color: "text-c27-icon-green",
    tile: "c27-tile-mint",
  },
];
---

<div
  class="c27-rise c27-gradient-blue px-[clamp(1.5rem,5vw,4.5rem)] py-[clamp(3rem,6vw,5rem)]"
>
  <div class="flex flex-col items-center gap-8 text-center">
    <h2 class="c27-h2 max-w-none text-c27-ink">
      Hire leaders who can build the function
    </h2>
    <div>
      <p class="mx-auto max-w-[52ch] text-body leading-relaxed text-c27-ink-2">
        Executive search for leaders who can set direction, build teams, and own
        the outcome.
      </p>
      <div class="mt-6">
        <Button href={ROUTES.hire} variant="primary" arrow
          >Start a leadership search</Button
        >
      </div>
    </div>
  </div>

  <ul
    class="mt-[clamp(2.5rem,5vw,4rem)] grid gap-3 md:grid-cols-2 lg:grid-cols-4"
  >
    {
      LEADERSHIP_AREAS.map((area) => (
        <li class:list={["c27-feature-card p-6 lg:min-h-44"]}>
          <span
            class:list={[
              "grid size-11 place-items-center",
              area.color,
              area.tile,
            ]}
            aria-hidden="true"
          >
            <Icon name={area.icon} size={24} />
          </span>
          <h3 class="c27-h3 mt-5 font-semibold text-c27-ink">{area.title}</h3>
          <p class="mt-2 text-body-sm leading-relaxed text-c27-ink-2">
            {area.roles}
          </p>
        </li>
      ))
    }
  </ul>
</div>
