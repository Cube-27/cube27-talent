---
import Button from "@/components/ui/Button.astro";
import { ROUTES } from "@/site-config";

/**
 * Leadership and CXO hiring. Plan §3.3, item 5.
 *
 * Deliberately short. A board hiring a CTO does not want a feature list, and
 * the credibility of this section rests on restraint rather than on claims we
 * cannot yet evidence.
 */

const ROLES = [
  "CTO",
  "CIO",
  "CISO",
  "VP Engineering",
  "Head of Product",
  "Head of Data",
];
---

<div
  class="c27-rise grid items-center gap-8 rounded-c27-lg bg-c27-deep p-[clamp(2rem,4.5vw,3.5rem)] lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]"
>
  <div>
    <span
      class="c27-label mb-3 inline-flex items-center gap-2 text-c27-on-deep-accent"
    >
      <i class="size-1.5 rounded-full bg-c27-on-deep-accent"></i>
      Leadership
    </span>
    <h2 class="c27-h2 text-c27-on-deep">Hiring the person who runs it</h2>
    <p class="mt-4 max-w-[52ch] text-body leading-relaxed text-c27-on-deep-2">
      Senior and executive searches are run discreetly and assessed on the thing
      that actually matters at that level — how someone has built a team, held
      it together and made the calls nobody else wanted to make.
    </p>
    <div class="mt-8">
      <Button href={ROUTES.hire} variant="on-deep" arrow
        >Start a leadership search</Button
      >
    </div>
  </div>

  <ul class="grid gap-2.5 sm:grid-cols-2">
    {
      ROLES.map((role) => (
        <li class="rounded-c27-sm border border-c27-line-deep bg-c27-deep-2 px-4 py-3 font-display text-body-sm font-semibold text-c27-on-deep">
          {role}
        </li>
      ))
    }
  </ul>
</div>
