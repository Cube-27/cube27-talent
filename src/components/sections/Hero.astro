---
import Button from "@/components/ui/Button.astro";
import { VERIFIED_PROOF } from "@/data/proof";
import { ROUTES } from "@/site-config";

const HERO_CAPABILITIES = [
  {
    title: "Qualified shortlists",
    body: "Candidates assessed for the role",
  },
  {
    title: "Complete team builds",
    body: "One hire or several functions",
  },
  {
    title: "Compliance",
    body: "Coordination across payroll, local requirements, and culture",
  },
  {
    title: "Leadership search",
    body: "CTO, CIO, COO, VPs, and functional heads",
  },
];
---

<section class="c27-sky-field border-b border-c27-line text-c27-ink">
  <div class="c27-wrap pt-[clamp(3rem,6vw,5rem)] text-center">
    <h1 class="c27-rise c27-display mx-auto">
      Build the team your business needs
    </h1>
    <p
      class="c27-rise mx-auto mt-6 max-w-[62ch] text-lg leading-relaxed text-c27-ink-2"
      style="--c27-d:60ms"
    >
      Managed hiring for specialists, complete teams, and senior leadership,
      with ongoing workforce support.
    </p>

    <div
      class="c27-rise mt-7 flex flex-wrap items-center justify-center gap-x-6 gap-y-4"
      style="--c27-d:100ms"
    >
      <Button href={ROUTES.hire} variant="primary" arrow>Build your team</Button
      >
      <a
        href={ROUTES.join}
        class="inline-flex min-h-11 items-center justify-center font-semibold text-c27-ink-2 underline decoration-c27-ink-3 underline-offset-4 transition-colors hover:text-c27-accent-d"
        >Looking for your next role?</a
      >
    </div>

    <div class="hero-capability-rail">
      {
        HERO_CAPABILITIES.map((item, index) => (
          <div
            class="hero-capability c27-rise"
            style={`--c27-d:${120 + index * 40}ms`}
          >
            <p class="font-display text-body font-semibold text-c27-ink">
              {item.title}
            </p>
            <p class="mt-1 text-body-sm leading-relaxed text-c27-ink-2">
              {item.body}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="hero-proof-band text-c27-ink">
    <div class="hero-proof-grid c27-wrap" aria-label="Company experience">
      {
        VERIFIED_PROOF.map((proof, index) => (
          <div
            class="hero-proof c27-rise"
            style={`--c27-d:${index * 60}ms`}
            aria-label={`${proof.value} ${proof.label}`}
          >
            <p class="font-display text-[clamp(1.75rem,3vw,2.25rem)] font-semibold leading-none tracking-[-0.035em] text-c27-accent-d tabular-nums">
              {proof.value}
            </p>
            <p class="text-body-sm font-medium text-c27-ink-2">{proof.label}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .hero-capability-rail {
    display: grid;
    gap: 1.5rem 2rem;
    margin-top: 2.5rem;
    padding-bottom: 2rem;
    text-align: left;
  }

  .hero-capability {
    position: relative;
    padding-left: 1.25rem;
  }

  .hero-capability::before {
    position: absolute;
    top: 0.5rem;
    left: 0;
    width: 0.4375rem;
    height: 0.4375rem;
    background: var(--c27-accent);
    content: "";
  }

  .hero-proof-band {
    background: var(--c27-accent-soft);
  }

  .hero-proof-grid {
    display: grid;
    gap: 1rem 3rem;
    padding-block: 1.25rem;
  }

  .hero-proof {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.875rem;
  }

  @media (min-width: 40rem) {
    .hero-capability-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: clamp(3rem, 6vw, 5rem);
      padding-bottom: clamp(1.75rem, 4vw, 2.75rem);
    }

    .hero-proof-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 1.25rem;
      padding-block: 1.5rem;
    }

    .hero-proof {
      gap: 0.75rem;
    }
  }

  @media (min-width: 64rem) {
    .hero-capability-rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
