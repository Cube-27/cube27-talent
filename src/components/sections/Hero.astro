---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import SnapshotCard from "@/components/ui/SnapshotCard.astro";
import { VERIFIED_PROOF } from "@/data/proof";
import { ROUTES } from "@/site-config";

const stats = VERIFIED_PROOF.slice(0, 3);
// Proof gating can leave one, two or three points, so the column count has to
// follow the data — a fixed grid-cols-3 leaves an empty cell. Full class names
// only, so Tailwind's scanner sees them.
const statsColumns =
  stats.length === 1
    ? "grid-cols-1"
    : stats.length === 2
      ? "grid-cols-2"
      : "grid-cols-3";
---

<section
  class="relative overflow-hidden border-b border-c27-line bg-[linear-gradient(180deg,#fff_0%,var(--c27-ground)_100%)] pb-[clamp(3rem,6vw,5rem)] pt-[clamp(2.75rem,5vw,4.25rem)]"
>
  {
    /* Structural grid wash. Texture without imagery — the site ships no
       photography (invariant 32 forbids fake candidate imagery, and stock
       office photos add nothing). */
  }
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 opacity-55 [background-image:linear-gradient(to_right,var(--c27-line)_1px,transparent_1px),linear-gradient(to_bottom,var(--c27-line)_1px,transparent_1px)] [background-size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_55%_at_50%_0%,#000_60%,transparent_100%)]"
  >
  </div>

  <div
    class="c27-wrap relative grid items-center gap-[clamp(2.5rem,5vw,4rem)] lg:grid-cols-[minmax(0,1.05fr)_minmax(21rem,0.95fr)]"
  >
    <div>
      <p
        class="c27-rise inline-flex items-center gap-2 rounded-full border border-[#c7d7fb] bg-c27-blue-soft/70 px-3.5 py-1.5 text-caption font-semibold text-c27-blue-d"
      >
        <Icon name="shield" size={14} />
        Managed engineering staffing &middot; Global
      </p>

      <h1 class="c27-rise c27-display mt-4.5" style="--c27-d:60ms">
        Hire engineers who are <span
          class="bg-[linear-gradient(var(--c27-green),var(--c27-green))] bg-[length:100%_0.09em] bg-[position:0_96%] bg-no-repeat text-c27-blue motion-safe:animate-[c27-draw_700ms_var(--c27-ease)_450ms_both]"
          >already tested</span
        >
      </h1>

      <p class="c27-rise c27-lede mt-4.5 max-w-[44ch]" style="--c27-d:140ms">
        Cube27 screens and technically interviews the talent, employs them, and
        runs their payroll. The client directs the work and decides who stays.
      </p>

      {
        stats.length > 0 && (
          <div
            class={`c27-rise mt-7 grid max-w-[30rem] ${statsColumns} gap-4 border-t border-c27-line pt-5`}
            style="--c27-d:220ms"
          >
            {stats.map((stat) => (
              <div>
                <b class="block font-display text-2xl font-extrabold leading-none tracking-[-0.035em] tabular-nums">
                  {stat.value}
                </b>
                <span class="mt-1.5 block text-caption text-c27-ink-2">
                  {stat.label}
                </span>
              </div>
            ))}
          </div>
        )
      }

      <div class="c27-rise mt-7 flex flex-wrap gap-3" style="--c27-d:300ms">
        <Button href={ROUTES.hire} variant="primary" arrow>Hire talent</Button>
        <Button href={ROUTES.join} variant="line">Find a job</Button>
      </div>
    </div>

    <div class="c27-rise relative px-2 py-5" style="--c27-d:360ms">
      <span
        class="absolute -left-3 -top-1 z-[3] hidden items-center gap-2 rounded-full border border-c27-line bg-c27-surface px-3 py-1.5 text-caption font-semibold shadow-c27-sm motion-safe:animate-[c27-bob_5.5s_ease-in-out_infinite] sm:inline-flex"
      >
        <i class="size-2 rounded-full bg-c27-blue"></i>Go &middot; Kubernetes
      </span>
      <span
        class="absolute -right-4 top-[44%] z-[3] hidden items-center gap-2 rounded-full border border-c27-line bg-c27-surface px-3 py-1.5 text-caption font-semibold shadow-c27-sm motion-safe:animate-[c27-bob_5.5s_ease-in-out_-2.7s_infinite] sm:inline-flex"
      >
        <i class="size-2 rounded-full bg-c27-green"></i>References verified
      </span>

      <SnapshotCard />
    </div>
  </div>
</section>

<style is:global>
  @keyframes c27-draw {
    from {
      background-size: 0 0.09em;
    }
  }
  @keyframes c27-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-7px);
    }
  }
</style>
