---
import CheckMark from "@/components/ui/CheckMark.astro";
import { INCLUSIONS } from "@/data/process";
---

<div class="border-b border-c27-line bg-c27-surface py-6">
  <div
    class="c27-wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-4"
  >
    <p
      class="text-caption font-semibold uppercase tracking-[0.06em] text-c27-ink-3"
    >
      Included with every placement
    </p>
    <ul class="flex flex-wrap gap-x-8 gap-y-2.5">
      {
        INCLUSIONS.map((item) => (
          <li class="inline-flex items-center gap-2 text-body-sm text-c27-ink-2">
            <CheckMark size={16} />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</div>
