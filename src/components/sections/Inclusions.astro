---
import CheckMark from "@/components/ui/CheckMark.astro";
import { INCLUSIONS } from "@/data/process";
---

<div class="border-b border-c27-line bg-c27-surface-2/60 py-5">
  <div
    class="c27-wrap flex flex-wrap items-center justify-between gap-x-8 gap-y-4"
  >
    <p class="text-caption font-bold uppercase tracking-[0.1em] text-c27-ink-3">
      Included with every placement
    </p>
    <ul class="flex flex-wrap gap-x-6 gap-y-2.5">
      {
        INCLUSIONS.map((item) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-c27-line bg-c27-surface px-3.5 py-1.5 text-body-sm font-medium text-c27-ink-2 shadow-2xs">
            <CheckMark size={16} />
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</div>
