---
import Icon from "@/components/ui/Icon.astro";
import { ROLE_FAMILIES, OPEN_SCOPE_LINE } from "@/data/roles";

interface Props {
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<div
  class="c27-rise grid border border-c27-line bg-c27-surface lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]"
  data-expertise
>
  <div
    class="expertise-tabs flex snap-x snap-mandatory overflow-x-auto border-b border-c27-line bg-c27-surface-2 [scrollbar-width:none] lg:flex-col lg:snap-none lg:overflow-visible lg:border-b-0 lg:border-r"
    role="tablist"
    aria-label="Areas of expertise"
  >
    {
      ROLE_FAMILIES.map((family, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${family.id}`}
          aria-controls={`panel-${family.id}`}
          aria-selected={index === 0 ? "true" : "false"}
          tabindex={index === 0 ? 0 : -1}
          class="flex min-h-14 shrink-0 snap-start items-center gap-3 whitespace-nowrap border-r border-c27-line px-5 py-3 text-left text-body-sm font-medium text-c27-ink-2 transition-[background-color,color] duration-[var(--c27-dur-fast)] hover:bg-c27-accent-soft hover:text-c27-ink aria-selected:bg-c27-accent aria-selected:font-semibold aria-selected:text-white lg:w-full lg:border-b lg:border-r-0"
        >
          <Icon name={family.icon} size={18} />
          <span>{family.short}</span>
        </button>
      ))
    }
  </div>

  <div class="p-[clamp(1.75rem,4vw,3.5rem)]">
    {
      ROLE_FAMILIES.map((family, index) => (
        <div
          role="tabpanel"
          id={`panel-${family.id}`}
          aria-labelledby={`tab-${family.id}`}
          hidden={index !== 0}
          data-panel
        >
          <Heading class="c27-h3-lg font-semibold text-c27-ink">
            {family.name}
          </Heading>
          <p class="mt-3 max-w-[58ch] text-body leading-relaxed text-c27-ink-2">
            {family.blurb}
          </p>
          <ul class="mt-7 grid gap-3 sm:grid-cols-2">
            {family.roles.map((role) => (
              <li class="c27-feature-card px-4 py-3 text-body-sm font-medium text-c27-ink">
                {role}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</div>

<p class="c27-rise mt-6 max-w-[68ch] text-body leading-relaxed text-c27-ink-2">
  {OPEN_SCOPE_LINE}
</p>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-expertise]",
  )) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, itemIndex) => {
        tab.setAttribute("aria-selected", String(itemIndex === index));
        tab.tabIndex = itemIndex === index ? 0 : -1;
      });
      panels.forEach((panel, itemIndex) => {
        panel.hidden = itemIndex !== index;
      });
      if (focus) tabs[index].focus();
    };

    select(0);

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        const delta =
          event.key === "ArrowDown" || event.key === "ArrowRight"
            ? 1
            : event.key === "ArrowUp" || event.key === "ArrowLeft"
              ? -1
              : 0;
        if (!delta) return;
        event.preventDefault();
        select((index + delta + tabs.length) % tabs.length, true);
      });
    });
  }
</script>

<style>
  .expertise-tabs::-webkit-scrollbar {
    display: none;
  }
</style>
