---
import Button from "@/components/ui/Button.astro";
import Icon from "@/components/ui/Icon.astro";
import Pill from "@/components/ui/Pill.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { ROLE_FAMILIES, OPEN_SCOPE_LINE } from "@/data/roles";
import { ROUTES } from "@/site-config";

/**
 * The capability map: a numbered rail of functions on the left, and the
 * selected function's panel on the right as a filled lavender field.
 *
 * The rail is a real tablist — roving tabindex, arrow keys with wraparound,
 * and every panel present in the DOM so a visitor without JavaScript reads all
 * of them rather than one.
 */
interface Props {
  index?: string;
  heading: string;
  lede: string;
}

const { index = "03", heading, lede } = Astro.props;
---

<div class="c27-roles">
  <SectionHead
    index={index}
    label="Capability map"
    heading={heading}
    lede={lede}
  />

  <div class="c27-roles-grid c27-rise" data-expertise>
    <div class="c27-role-nav" role="tablist" aria-label="Talent functions">
      {
        ROLE_FAMILIES.map((family, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${family.id}`}
            aria-controls={`panel-${family.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            class="c27-indent"
          >
            <span class="c27-role-nav-index" aria-hidden="true">
              {String(i + 1).padStart(2, "0")}
            </span>
            <span>{family.short}</span>
            <Icon name="arrow-up-right" size={16} data-arrow />
          </button>
        ))
      }
    </div>

    <div class="c27-role-panels">
      {
        ROLE_FAMILIES.map((family) => (
          <div
            class="c27-panel"
            role="tabpanel"
            id={`panel-${family.id}`}
            aria-labelledby={`tab-${family.id}`}
            data-panel
          >
            {/* No index here: the numbered rail on the left already carries
                the position and marks the selected one. */}
            <div class="c27-role-head">
              <h3 class="c27-role-statement">{family.statement}</h3>
              <div class="c27-role-metric">
                <span class="c27-role-metric-label">{family.metricLabel}</span>
                <span class="c27-role-metric-val">{family.metric}</span>
              </div>
            </div>

            <p class="c27-role-blurb">{family.blurb}</p>

            <ul class="c27-role-pills">
              {family.roles.map((role) => (
                <li>
                  <Pill>{role}</Pill>
                </li>
              ))}
            </ul>

            <Button href={ROUTES.hire} variant="link" arrow>
              Talk about this function
            </Button>
          </div>
        ))
      }
    </div>
  </div>

  <p class="c27-roles-scope c27-rise">{OPEN_SCOPE_LINE}</p>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-expertise]",
  )) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, itemIndex) => {
        tab.setAttribute("aria-selected", String(itemIndex === index));
        tab.tabIndex = itemIndex === index ? 0 : -1;
      });
      panels.forEach((panel, itemIndex) => {
        panel.hidden = itemIndex !== index;
      });
      if (focus) tabs[index].focus();
    };

    select(0);

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        const delta =
          event.key === "ArrowDown" || event.key === "ArrowRight"
            ? 1
            : event.key === "ArrowUp" || event.key === "ArrowLeft"
              ? -1
              : 0;
        if (!delta) return;
        event.preventDefault();
        select((index + delta + tabs.length) % tabs.length, true);
      });
    });
  }
</script>

<style>
  .c27-roles-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    border-top: 1px solid var(--c27-line-3);
  }

  .c27-role-nav {
    padding: 0.625rem 2.2vw 0 0;
  }

  .c27-role-nav button {
    display: grid;
    grid-template-columns: 35px minmax(0, 1fr) 20px;
    align-items: center;
    gap: 0.4375rem;
    width: 100%;
    padding: 1.125rem 0;
    border: 0;
    border-bottom: 1px solid var(--c27-line);
    background: transparent;
    text-align: left;
    font-size: 0.875rem;
    color: var(--c27-ink-2);
    cursor: pointer;
  }

  .c27-role-nav-index {
    font-family: var(--c27-font-display);
    font-size: var(--c27-text-label);
    font-weight: 600;
    letter-spacing: var(--c27-track-index);
    color: var(--c27-ink-3);
  }

  /* The active/hover treatment has to live here, not on `.c27-indent` alone:
     the rule above sets `color` from this component's unlayered scoped sheet,
     which outranks anything in @layer components regardless of specificity. */
  .c27-role-nav button:hover,
  .c27-role-nav button[aria-selected="true"] {
    color: var(--c27-accent-d);
    padding-left: 0.625rem;
  }

  .c27-role-nav button[aria-selected="true"] {
    font-weight: 600;
  }

  .c27-role-nav button[aria-selected="true"] .c27-role-nav-index,
  .c27-role-nav button:hover .c27-role-nav-index {
    color: var(--c27-accent);
  }

  /* Pulls the panel over the grid's top rule so the fill appears to sit on it
     rather than below it. Tall enough that the panel does not resize as you
     switch functions — the longest copy sets it — without leaving dead fill
     under the shortest. */
  .c27-role-panels > .c27-panel {
    margin-top: -1px;
    min-height: 24rem;
  }

  /* The statement and its tag share a row, so the heading starts at the panel's
     top padding instead of below a separate head block. */
  .c27-role-head {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 1.25rem;
  }

  .c27-role-statement {
    margin: 0;
    max-width: 22ch;
    font-family: var(--c27-font-display);
    font-size: clamp(1.5rem, 2.4vw, 1.875rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--c27-ink);
  }

  /* Spec metadata badge: a clean warm grey chip with uppercase label and value */
  .c27-role-metric {
    flex: none;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
    padding: 0.5rem 0.8125rem;
    background: var(--c27-ground);
    border: 1px solid var(--c27-line);
  }

  .c27-role-metric-label {
    font-family: var(--c27-font-body);
    font-size: var(--c27-text-index);
    font-weight: 600;
    line-height: 1;
    letter-spacing: var(--c27-track-index);
    text-transform: uppercase;
    color: var(--c27-ink-3);
  }

  .c27-role-metric-val {
    font-family: var(--c27-font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.015em;
    color: var(--c27-accent);
    font-variant-numeric: tabular-nums;
  }

  .c27-role-blurb {
    max-width: 46ch;
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--c27-ink-2);
  }

  .c27-role-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1.5625rem 0 2.1875rem;
  }

  .c27-roles-scope {
    margin-top: 1.75rem;
    max-width: 68ch;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--c27-ink-2);
  }

  @media (max-width: 56.25rem) {
    .c27-roles-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .c27-role-nav {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 0.9375rem;
      padding-right: 0;
    }

    .c27-role-nav button {
      grid-template-columns: 21px minmax(0, 1fr);
      font-size: 0.8125rem;
    }

    .c27-role-nav button [data-arrow] {
      display: none;
    }

    .c27-role-panels > .c27-panel {
      margin-top: 1.875rem;
      min-height: 0;
    }
  }

  @media (max-width: 32.5rem) {
    .c27-role-nav {
      grid-template-columns: minmax(0, 1fr);
    }

    /* No room for a heading and a tag side by side at this width. */
    .c27-role-head {
      flex-direction: column;
      align-items: start;
      gap: 1rem;
    }
  }
</style>
