---
import Icon from "@/components/ui/Icon.astro";
import { ROLE_FAMILIES } from "@/data/roles";

/**
 * Tabbed role-family selector. Design system §6.7.
 *
 * All eight panels are server-rendered and JS only toggles `hidden` and
 * `aria-selected`. The panels ship hidden so a scripted visit paints the
 * selected one straight away rather than flashing all eight and collapsing.
 * Without JS that `hidden` is overridden in globals.css, so the full taxonomy
 * stays readable (plan §19.4 progressive enhancement).
 */

interface Props {
  /**
   * Level for the family name inside each panel. The home page nests this
   * under a section h2, so 3 is right there; the expertise page puts it
   * directly under the page h1, where 3 would skip a level.
   */
  headingLevel?: 2 | 3;
}

const { headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<div
  class="c27-rise grid overflow-hidden rounded-c27-lg border border-c27-line bg-c27-surface shadow-c27-sm lg:grid-cols-[minmax(0,17.5rem)_minmax(0,1fr)]"
  data-expertise
>
  {
    /* scroll-px matches the strip padding: without it a snapped tab rests flush
      against the card edge, because snapping aligns to the scrollport, not the
      padding box. */
  }
  <div
    class="flex snap-x snap-mandatory scroll-px-3 gap-1.5 overflow-x-auto border-b border-c27-line bg-c27-surface-2/80 p-3 [scrollbar-width:thin] lg:flex-col lg:snap-none lg:overflow-visible lg:border-b-0 lg:border-r lg:p-4"
    role="tablist"
    aria-label="Role families"
  >
    {
      ROLE_FAMILIES.map((family, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${family.id}`}
          aria-controls={`panel-${family.id}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          class="flex min-h-11 shrink-0 snap-start items-center gap-2.5 whitespace-nowrap rounded-c27-sm px-3.5 py-2.5 text-left text-body-sm font-medium text-c27-ink-2 transition-[background-color,color,box-shadow] duration-200 hover:bg-c27-tint hover:text-c27-ink aria-selected:bg-c27-blue aria-selected:font-semibold aria-selected:text-white aria-selected:shadow-c27-sm"
        >
          <Icon name={family.icon} size={18} />
          <span>{family.name}</span>
        </button>
      ))
    }
  </div>

  <div class="p-[clamp(1.75rem,3.5vw,2.5rem)]">
    {
      ROLE_FAMILIES.map((family, i) => (
        <div
          role="tabpanel"
          id={`panel-${family.id}`}
          aria-labelledby={`tab-${family.id}`}
          hidden={i !== 0}
          data-panel
        >
          <Heading class="c27-h3-lg font-bold text-c27-ink tracking-tight">
            {family.name}
          </Heading>
          <p class="mt-2.5 max-w-[52ch] text-body-sm text-c27-ink-2 leading-relaxed">
            {family.blurb}
          </p>
          <ul class="mt-5.5 flex flex-wrap gap-2.5">
            {family.roles.map((role) => (
              <li class="rounded-full border border-c27-line bg-c27-surface-2/60 px-3.5 py-1.5 text-body-sm font-medium text-c27-ink transition-colors hover:border-c27-blue/40">
                {role}
              </li>
            ))}
          </ul>
          <div class="mt-6 flex flex-wrap gap-x-8 gap-y-3 border-t border-c27-line-2 pt-5 text-caption font-medium text-c27-ink-3">
            <span class="inline-flex items-center gap-1.5">
              <i class="size-1.5 rounded-full bg-c27-green-d" /> Full-time
              employment through Cube27
            </span>
            <span class="inline-flex items-center gap-1.5">
              <i class="size-1.5 rounded-full bg-c27-blue" /> Remote &middot;
              hybrid &middot; onsite &middot; relocation
            </span>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  // Roving tabindex with arrow-key support, per WAI-ARIA tabs pattern.
  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-expertise]",
  )) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];

    const select = (index: number, focus = false) => {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
      if (focus) {
        tabs[index].focus();
        // Smooth scrolling lives here rather than on the strip as
        // `scroll-behavior: smooth`. A snap container that is also smooth
        // animates its initial snap during load, and Chrome then reports no
        // LCP candidate for the whole page at all — Lighthouse fails with
        // NO_LCP, which also takes TBT and TTI down with it. Doing it on
        // keyboard selection keeps the behaviour and never runs at load.
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          tabs[index].scrollIntoView({
            behavior: "smooth",
            block: "nearest",
            inline: "nearest",
          });
        }
      }
    };

    // Only collapse to one visible panel once JS is running.
    select(0);

    tabs.forEach((tab, i) => {
      tab.addEventListener("click", () => select(i));
      tab.addEventListener("keydown", (event) => {
        const delta =
          event.key === "ArrowDown" || event.key === "ArrowRight"
            ? 1
            : event.key === "ArrowUp" || event.key === "ArrowLeft"
              ? -1
              : 0;
        if (!delta) return;
        event.preventDefault();
        select((i + delta + tabs.length) % tabs.length, true);
      });
    });
  }
</script>
