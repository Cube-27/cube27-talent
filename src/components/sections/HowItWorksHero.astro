---
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import Eyebrow from "@/components/ui/Eyebrow.astro";
import { ROUTES } from "@/site-config";

const EVIDENCE = [
  {
    title: "Relevant work",
    body: "Assessment built around the role.",
    icon: "briefcase" as const,
  },
  {
    title: "Practitioner review",
    body: "Experienced domain practitioners evaluate the evidence and conduct in-depth interviews.",
    icon: "person" as const,
  },
  {
    title: "Decision-ready shortlist",
    body: "See strengths and gaps before interview.",
    icon: "check" as const,
  },
];
---

<section class="c27-hiw-hero c27-blueprint">
  <div class="c27-wrap">
    <div class="c27-hiw-head">
      <div class="c27-rise c27-hiw-copy">
        <span class="c27-rule-mark c27-hero-mark" aria-hidden="true"></span>
        <Eyebrow>Evidence-led hiring</Eyebrow>
        <h1 class="c27-display mt-6 max-w-[16ch] text-c27-ink">
          Hire with proof, not promises
        </h1>
      </div>
      <div class="c27-rise c27-hiw-aside" style="--c27-d:80ms">
        <p class="c27-lede">
          Every shortlisted candidate completes role-specific work and a
          practitioner interview before reaching your team.
        </p>
        <Button href={ROUTES.hire} variant="primary" arrow class="mt-7">
          Build your team
        </Button>
      </div>
    </div>

    <ul class="c27-rule-grid mt-[clamp(3rem,5vw,4.5rem)]" style="--c27-cols:3">
      {
        EVIDENCE.map((item, index) => (
          <li class="c27-rise" style={`--c27-d:${index * 60}ms`}>
            <Icon name={item.icon} size={24} class="text-c27-accent" />
            {/* h2, not h3, despite matching the grids elsewhere: these sit
                directly under the page h1 with no section heading between, so
                h3 would skip a level. Heading rank follows document position,
                not visual similarity. */}
            <h2 class="c27-card-title mt-4 font-semibold text-c27-ink">
              {item.title}
            </h2>
            <p class="mt-2 max-w-[34ch] text-body-sm leading-relaxed text-c27-ink-2">
              {item.body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .c27-hiw-hero {
    --c27-hero-pad-top: calc(5.5vw + 4.5rem);
    --c27-hero-pad-bottom: clamp(3rem, 5vw, 4.5rem);

    margin-top: -4.5rem;
    padding-top: var(--c27-hero-pad-top);
    padding-bottom: var(--c27-hero-pad-bottom);
    background: var(--c27-ground);
  }

  .c27-hiw-head {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 4vw;
    align-items: start;
  }

  .c27-hiw-copy {
    position: relative;
    padding-left: clamp(25px, 3.4vw, 65px);
  }

  .c27-hero-mark {
    position: absolute;
    top: 0.125rem;
    left: 0;
  }

  .c27-hiw-aside {
    max-width: 34rem;
  }

  @media (max-width: 56.25rem) {
    .c27-hiw-hero {
      --c27-hero-pad-top: calc(12vw + 4.5rem);
    }

    .c27-hiw-head {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.75rem;
      align-items: start;
    }

    .c27-hero-mark {
      height: 57px;
    }

    .c27-hiw-copy {
      padding-left: 1.5rem;
    }
  }
</style>
