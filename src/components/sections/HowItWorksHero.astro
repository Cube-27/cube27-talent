---
import Icon from "@/components/ui/Icon.astro";

/**
 * How It Works hero.
 *
 * Rewritten under invariant rules 0.1 and 0.2 — no company name, and the
 * "client control" strip is gone: it was a responsibility matrix in strip form,
 * which is exactly what rule 0.2 removes. What is left says the same useful
 * thing positively, once.
 */

const phases = [
  {
    icon: "target",
    title: "Agree the brief",
    detail:
      "Role, level, budget range, location and working model, written down before the search starts.",
  },
  {
    icon: "spark",
    title: "Prove the fit",
    detail:
      "A screen, a recorded task matched to the discipline, then an interview run by someone who does that work.",
  },
  {
    icon: "briefcase",
    title: "Handle the hire",
    detail:
      "Offer, onboarding and the administration around it, so the first day is a working day.",
  },
  {
    icon: "compass",
    title: "Stay involved",
    detail:
      "Check-ins for as long as the engagement runs, and the next hire ready when the team grows.",
  },
];
---

<section class="bg-c27-deep text-c27-on-deep">
  <div class="c27-wrap py-[clamp(4rem,7vw,6.5rem)]">
    <h1 class="c27-rise c27-display max-w-none font-display">
      <span class="block">We build the team.</span>
      <span class="mt-2 block text-c27-on-deep-accent">You lead it.</span>
    </h1>

    <div
      class="mt-[clamp(2.75rem,5vw,4.5rem)] grid items-start gap-[clamp(3rem,6vw,6rem)] lg:grid-cols-[minmax(0,0.9fr)_minmax(24rem,1.1fr)]"
    >
      <div
        class="c27-rise max-w-[58ch] space-y-4 text-[clamp(1rem,1.35vw,1.125rem)] leading-relaxed text-c27-on-deep-2"
        style="--c27-d:100ms"
      >
        <p>
          We run the people side of delivery: agreeing what the role actually
          is, finding candidates, assessing them properly, and handling
          everything that turns an accepted offer into someone working.
        </p>
        <p>
          You interview whoever you want to interview, you choose, and you
          direct the work from there. Nothing about that changes because we
          found the person.
        </p>
      </div>

      <ol
        class="delivery-path c27-rise relative grid gap-2"
        aria-label="How we work"
        style="--c27-d:180ms"
      >
        {
          phases.map((phase) => (
            <li class="relative grid grid-cols-[3rem_minmax(0,1fr)] gap-4 py-3.5">
              <span class="relative z-[1] grid size-12 place-items-center rounded-full border border-c27-line-deep bg-c27-deep-2 text-c27-on-deep-accent">
                <Icon name={phase.icon} size={20} />
              </span>
              <div>
                <h2 class="text-lg tracking-[-0.02em] text-c27-on-deep">
                  {phase.title}
                </h2>
                <p class="mt-1 max-w-[40ch] text-body-sm text-c27-on-deep-2">
                  {phase.detail}
                </p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .delivery-path::before {
    position: absolute;
    inset-block: 2.25rem;
    left: 1.5rem;
    width: 1px;
    content: "";
    background: var(--c27-on-deep-accent);
    opacity: 0.4;
    transform-origin: top;
    animation: c27-delivery-line 900ms var(--c27-ease) 280ms both;
  }

  @keyframes c27-delivery-line {
    from {
      transform: scaleY(0);
    }
  }
</style>
