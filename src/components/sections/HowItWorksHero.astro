---
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import { ROUTES } from "@/site-config";

const EVIDENCE = [
  {
    title: "Relevant work",
    body: "Assessment built around the role.",
    icon: "briefcase" as const,
    color: "text-c27-icon-violet",
    tile: "c27-tile-violet",
  },
  {
    title: "Practitioner review",
    body: "An expert evaluates the evidence.",
    icon: "person" as const,
    color: "text-c27-icon-green",
    tile: "c27-tile-mint",
  },
  {
    title: "Decision-ready shortlist",
    body: "See strengths and gaps before interview.",
    icon: "check" as const,
    color: "text-c27-icon-blue",
    tile: "c27-tile-sky",
  },
];
---

<section class="c27-gradient-blue border-b border-c27-line">
  <div class="c27-wrap py-[clamp(2.75rem,5vw,4.5rem)] text-center">
    <div class="mx-auto max-w-4xl">
      <h1
        class="c27-rise c27-display mx-auto max-w-none text-center text-c27-ink"
      >
        Hire with proof, not promises
      </h1>
      <p
        class="c27-rise mx-auto mt-6 max-w-[68ch] text-[clamp(1.05rem,1.7vw,1.3rem)] leading-relaxed text-c27-ink-2"
      >
        Every shortlisted candidate completes role-specific work and a
        practitioner interview before reaching your team.
      </p>
      <div class="c27-rise mt-7" style="--c27-d:80ms">
        <Button href={ROUTES.hire} variant="primary" arrow
          >Build your team</Button
        >
      </div>
    </div>

    <ul
      class="mt-[clamp(2.5rem,4vw,3.5rem)] grid gap-4 text-left md:grid-cols-3"
    >
      {
        EVIDENCE.map((item, index) => (
          <li
            class:list={[
              "c27-rise c27-feature-card p-[clamp(1.5rem,3vw,2.25rem)]",
            ]}
            style={`--c27-d:${index * 60}ms`}
          >
            <span
              class:list={[
                "grid size-12 place-items-center",
                item.color,
                item.tile,
              ]}
              aria-hidden="true"
            >
              <Icon name={item.icon} size={24} />
            </span>
            <h2 class="c27-h3 mt-5 font-semibold">{item.title}</h2>
            <p class="mt-2 text-body-sm leading-relaxed text-c27-ink-2">
              {item.body}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
