---
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import { ROUTES } from "@/site-config";

const EVIDENCE = [
  {
    title: "Relevant work",
    body: "Assessment built around the role.",
    icon: "briefcase" as const,
  },
  {
    title: "Practitioner review",
    body: "Experienced domain practitioners evaluate the evidence and conduct in-depth interviews.",
    icon: "person" as const,
  },
  {
    title: "Decision-ready shortlist",
    body: "See strengths and gaps before interview.",
    icon: "check" as const,
  },
];
---

<section
  class="c27-sky-field -mt-[4.5rem] border-b border-c27-line pt-[4.5rem]"
>
  <div class="c27-wrap py-[clamp(2.5rem,4vw,3.5rem)] text-center">
    <div class="mx-auto max-w-4xl">
      <h1
        class="c27-rise c27-display mx-auto max-w-none text-center text-c27-ink"
      >
        Hire with proof, not promises
      </h1>
      <p class="c27-rise c27-lede-lg mx-auto mt-6">
        Every shortlisted candidate completes role-specific work and a
        practitioner interview before reaching your team.
      </p>
      <div class="c27-rise mt-7" style="--c27-d:80ms">
        <Button href={ROUTES.hire} variant="primary" arrow
          >Build your team</Button
        >
      </div>
    </div>

    <ul
      class="mt-[clamp(2.5rem,4vw,3.5rem)] grid gap-4 text-left md:grid-cols-3"
    >
      {
        EVIDENCE.map((item, index) => (
          <li
            class="c27-card-shadow c27-rise flex flex-col justify-start border border-c27-line bg-c27-surface p-5 sm:p-6 text-left"
            style={`--c27-d:${index * 60}ms`}
          >
            <span
              class="c27-tile-accent grid size-10 place-items-center border border-c27-accent/15 text-c27-accent"
              aria-hidden="true"
            >
              <Icon name={item.icon} size={20} />
            </span>
            <div class="mt-4">
              {/* h2, not h3, despite matching the card grids elsewhere: these
                  sit directly under the page h1 with no section heading
                  between, so h3 would skip a level. Heading rank follows
                  document position, not visual similarity. */}
              <h2 class="c27-card-title font-semibold text-c27-ink">
                {item.title}
              </h2>
              <p class="mt-2 text-body-sm leading-relaxed text-c27-ink-2">
                {item.body}
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
