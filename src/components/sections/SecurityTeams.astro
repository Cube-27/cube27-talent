---
import Icon from "@/components/ui/Icon.astro";
import Button from "@/components/ui/Button.astro";
import { SECURITY_DISCLAIMER } from "@/data/roles";
import { ROUTES } from "@/site-config";

const CAPABILITIES = [
  {
    title: "Application security",
    body: "Protect products, platforms, and customer data.",
    icon: "shield" as const,
    color: "text-c27-icon-violet",
    tile: "c27-tile-violet",
  },
  {
    title: "Security operations",
    body: "Build detection, response, and incident readiness.",
    icon: "target" as const,
    color: "text-c27-icon-blue",
    tile: "c27-tile-sky",
  },
  {
    title: "Risk and compliance",
    body: "Strengthen controls, governance, and audit readiness.",
    icon: "check" as const,
    color: "text-c27-icon-green",
    tile: "c27-tile-mint",
  },
  {
    title: "Security leadership",
    body: "Hire the people who can set direction and deliver it.",
    icon: "compass" as const,
    color: "text-c27-icon-orange",
    tile: "c27-tile-peach",
  },
];

const STANDARDS = [
  { name: "ISO 27001", note: "Information security" },
  { name: "SOC 2", note: "Trust services" },
  { name: "PCI DSS", note: "Payment security" },
  { name: "HIPAA", note: "Health data" },
  { name: "GDPR", note: "Data protection" },
];
---

<div class="c27-rise">
  <div
    class="flex flex-col items-center gap-8 border-b border-c27-line-deep pb-[clamp(2rem,4vw,3rem)] text-center"
  >
    <div>
      <h2 class="c27-h2 max-w-none">
        Build a security team for the standard ahead
      </h2>
      <p
        class="mx-auto mt-5 max-w-[58ch] text-[clamp(1rem,1.4vw,1.125rem)] leading-relaxed text-c27-ink-2"
      >
        Hire security specialists and leaders who understand the controls,
        evidence, and operating discipline your business needs.
      </p>
    </div>
    <div>
      <Button href={ROUTES.hire} variant="primary" arrow
        >Build a security team</Button
      >
    </div>
  </div>

  <ul class="mt-8 grid gap-3 md:grid-cols-2 lg:grid-cols-4">
    {
      CAPABILITIES.map((item) => (
        <li class:list={["c27-soft-panel p-6 lg:min-h-48"]}>
          <span
            class:list={[
              "grid size-11 place-items-center",
              item.color,
              item.tile,
            ]}
            aria-hidden="true"
          >
            <Icon name={item.icon} size={24} />
          </span>
          <h3 class="c27-h3 mt-5 font-semibold">{item.title}</h3>
          <p class="mt-2 text-body-sm leading-relaxed text-c27-ink-2">
            {item.body}
          </p>
        </li>
      ))
    }
  </ul>

  <div class="pt-[clamp(2rem,4vw,3rem)]">
    <div
      class="flex flex-col gap-2 md:flex-row md:items-end md:justify-between"
    >
      <h3 class="c27-h3-lg font-semibold">
        Standards your team can work toward
      </h3>
      <p
        class="max-w-[48ch] text-caption leading-relaxed text-c27-ink-2 md:text-right"
      >
        {SECURITY_DISCLAIMER}
      </p>
    </div>
    <ul class="mt-7 grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
      {
        STANDARDS.map((standard) => (
          <li class="c27-feature-card px-5 py-6">
            <p class="font-display text-lg font-semibold tracking-[-0.025em] text-c27-accent">
              {standard.name}
            </p>
            <p class="mt-1 text-caption text-c27-ink-2">{standard.note}</p>
          </li>
        ))
      }
    </ul>
  </div>
</div>
