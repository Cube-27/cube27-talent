---
import Icon from "@/components/ui/Icon.astro";
import { PROCESS_PHASES } from "@/data/process";
---

<div
  class="grid gap-[clamp(3rem,7vw,7rem)] lg:grid-cols-[minmax(17rem,0.6fr)_minmax(0,1fr)]"
  data-process-rail
>
  <div class="c27-rise lg:sticky lg:top-28 lg:self-start">
    <h3
      class="c27-card-title font-semibold text-c27-on-deep lg:whitespace-nowrap"
    >
      From role brief to final selection.
    </h3>
    <p
      class="mt-7 border-t border-c27-line-deep pt-5 text-body-sm leading-relaxed text-c27-on-deep-2"
    >
      AI supports the search. People make every decision.
    </p>
  </div>

  <div class="process-list relative" data-phase-list>
    <span
      aria-hidden="true"
      class="process-track absolute bottom-0 left-[1.375rem] top-0 w-px bg-c27-line-deep"
    >
      <i
        class="block h-[var(--process-progress,25%)] w-full bg-c27-on-deep-accent transition-[height] duration-500 ease-[var(--c27-ease)]"
      ></i>
    </span>

    {
      PROCESS_PHASES.map((phase, index) => (
        <article
          class="process-phase relative grid min-h-40 grid-cols-[2.75rem_minmax(0,1fr)] content-center gap-5 border-t border-c27-line-deep py-8 first:border-t-0 first:pt-0 last:pb-0"
          data-phase
          data-active={index === 0 ? "true" : "false"}
        >
          <span class="process-node relative z-[1] grid size-11 place-items-center border border-c27-line-deep bg-c27-deep text-c27-on-deep-3 transition-[background-color,border-color,color] duration-300">
            <Icon name={phase.icon} size={20} />
          </span>
          <div>
            <h3 class="c27-card-title font-semibold text-c27-on-deep">
              {phase.name}
            </h3>
            <p class="mt-2 text-body-sm leading-relaxed text-c27-on-deep/80">
              {phase.summary}
            </p>
            <ul class="mt-5 flex flex-wrap gap-x-6 gap-y-2">
              {phase.points.map((point) => (
                <li class="text-body-sm text-c27-on-deep-2">{point}</li>
              ))}
            </ul>
          </div>
        </article>
      ))
    }
  </div>
</div>

<script>
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");

  for (const root of document.querySelectorAll<HTMLElement>(
    "[data-process-rail]",
  )) {
    const phases = [...root.querySelectorAll<HTMLElement>("[data-phase]")];
    const list = root.querySelector<HTMLElement>("[data-phase-list]");
    if (!phases.length || !list || reducedMotion.matches) continue;

    let activeIndex = 0;
    let ticking = false;

    const activate = (index: number) => {
      if (index === activeIndex) return;
      activeIndex = index;

      phases.forEach((phase) => {
        phase.dataset.active = String(phase === phases[index]);
      });
      list.style.setProperty(
        "--process-progress",
        `${((index + 1) / phases.length) * 100}%`,
      );
    };

    const update = () => {
      const focusLine = window.innerHeight * 0.44;
      let nextIndex = 0;

      phases.forEach((phase, index) => {
        if (phase.getBoundingClientRect().top <= focusLine) nextIndex = index;
      });

      activate(nextIndex);
      ticking = false;
    };

    const scheduleUpdate = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    update();
    window.addEventListener("scroll", scheduleUpdate, { passive: true });
    window.addEventListener("resize", scheduleUpdate);
  }
</script>

<style>
  .process-phase[data-active="true"] .process-node {
    border-color: var(--c27-accent);
    background: var(--c27-accent);
    color: white;
  }

  .process-node {
    transition-timing-function: var(--c27-ease);
  }

  @media (max-width: 63.999rem) {
    .process-track {
      display: none;
    }

    .process-phase .process-node {
      border-color: var(--c27-on-deep-accent);
      color: var(--c27-on-deep-accent);
    }
  }
</style>
