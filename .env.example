# Build-time variables read by Astro. Copy to .env for a local build.
# Runtime secrets for the Pages Functions live in .dev.vars — see
# .dev.vars.example.

# Cloudflare Turnstile site key. Rendered into the page, so it is public.
# The value below is Cloudflare's documented test key: it always passes and
# shows no challenge.
#
# This is an OVERRIDE, not the source of truth. Deployed builds take the key
# from TURNSTILE_SITE_KEYS in src/site-config.ts, selected by CF_PAGES_BRANCH,
# so nothing needs setting in the Cloudflare dashboard. Set this only for a
# local build or a deliberate one-off; when set, it wins over the branch key.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
