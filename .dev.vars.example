# Cube27 Talent — local Pages Functions environment.
# Copy to `.dev.vars` (git-ignored) for `pnpm preview`.
# In Cloudflare, set these per environment: production and preview MUST differ.
# Plan §13.2.

# Public origin, no trailing slash. Used for origin checks and links in email.
SITE_URL="http://localhost:8788"

# "production" | "preview" | "development". Tags internal email subjects.
ENVIRONMENT="development"

# Comma-separated hostnames allowed to POST to the endpoints.
ALLOWED_HOSTS="localhost:8788,127.0.0.1:8788"

# Resend — encrypted secret in Cloudflare.
RESEND_API_KEY=""

# Verified Resend sending identity. Use a sending subdomain, not the site host.
# `mail.cube27.com` is shared with the main Cube27 site; the `talent@` local
# part is what keeps this project's mail distinct. See docs/operations.md §3.1.
RESEND_FROM="Cube27 Talent <talent@mail.cube27.com>"

# Monitored reply-to for acknowledgement emails. Never no-reply.
RESEND_REPLY_TO="talent@cube27.com"

# Internal recipients. Employer requirements and candidate applications use
# separate production queues. The endpoints read these variables independently.
#
# Local and preview submissions must use dedicated non-production inboxes.
# Never use live recruitment mailboxes or plus-addressing variants here.
EMPLOYER_LEADS_TO="talent-leads-preview@cube27.com"
CANDIDATE_APPLICATIONS_TO="talent-apply-preview@cube27.com"

# Cloudflare Turnstile. Test keys: https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# 1x00000000000000000000AA always passes; 2x00000000000000000000AB always blocks.
